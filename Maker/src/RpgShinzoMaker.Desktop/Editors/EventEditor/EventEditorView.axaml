<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:eventEditor="using:RpgShinzoMaker.Desktop.Editors.EventEditor"
             x:Class="RpgShinzoMaker.Desktop.Editors.EventEditor.EventEditorView">

    <UserControl.Styles>
        <!-- Скроллбары -->
        <Style Selector="ScrollBar">
            <Setter Property="Opacity" Value="1"/>
            <Setter Property="Background" Value="#1E1E1E"/>
        </Style>
        <Style Selector="ScrollBar:vertical">
            <Setter Property="Width" Value="10"/>
        </Style>
        <Style Selector="ScrollBar:horizontal">
            <Setter Property="Height" Value="10"/>
        </Style>
        <Style Selector="ScrollBar /template/ Thumb">
            <Setter Property="Background" Value="#007ACC"/>
            <Setter Property="Opacity" Value="1"/>
        </Style>
        <Style Selector="ScrollBar /template/ Thumb:pointerover">
            <Setter Property="Background" Value="#1E90FF"/>
        </Style>
        <Style Selector="ScrollBar /template/ Thumb:pressed">
            <Setter Property="Background" Value="#005A9E"/>
        </Style>
        
        <!-- Уменьшенный шрифт в нижней панели EventEditor -->
        <Style Selector="ListBox#EventList ListBoxItem">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="MinHeight" Value="0"/>
            <Setter Property="Padding" Value="4,2"/>
        </Style>

        <!-- Поля: TextBox внутри StackPanel секций — селектор специфичнее темы -->
        <Style Selector="StackPanel TextBox">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Height" Value="24"/>
            <Setter Property="MinHeight" Value="0"/>
            <Setter Property="Padding" Value="4,0"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Background" Value="#1E1E1E"/>
            <Setter Property="BorderBrush" Value="#555555"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="2"/>
            <Setter Property="Foreground" Value="White"/>
        </Style>

        <Style Selector="StackPanel ComboBox">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Height" Value="24"/>
            <Setter Property="MinHeight" Value="0"/>
        </Style>

        <Style Selector="StackPanel TextBlock">
            <Setter Property="FontSize" Value="12"/>
        </Style>
    </UserControl.Styles>

    <Panel>
        <Grid ColumnDefinitions="250,4,*">

            <!-- ЛЕВАЯ КОЛОНКА -->
            <Border Grid.Column="0" Background="#252526" Padding="8">
                <Border Background="#1E1E1E" BorderBrush="#3E3E42" BorderThickness="1" CornerRadius="4">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <StackPanel Margin="8" Spacing="8">

                            <!-- КАРТА -->
                            <TextBlock Text="MAP" Foreground="White" FontWeight="Bold" FontSize="12"/>
                            <ComboBox x:Name="MapSelector" HorizontalAlignment="Stretch" SelectionChanged="OnMapSelectorChanged"/>

                            <TextBlock Text="VERSION" Foreground="White" FontWeight="Bold" FontSize="12" Margin="0,8,0,0"/>
                            <ComboBox x:Name="VersionSelector" HorizontalAlignment="Stretch" SelectionChanged="OnVersionSelectorChanged"/>
                            
                            <!-- РАЗДЕЛЫ -->
                            <TextBlock Text="SECTIONS" Foreground="White" FontWeight="Bold" FontSize="12" Margin="0,8,0,0"/>

                            <ToggleButton x:Name="SectionRoofBtn" Content="Roof Events" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Padding="6,4" Click="OnSectionRoofClick"/>
                            <ToggleButton x:Name="SectionTileChangeBtn" Content="Tile Changes" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Padding="6,4" Click="OnSectionTileChangeClick"/>
                            <ToggleButton x:Name="SectionStairBtn" Content="Stairs" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Padding="6,4" Click="OnSectionStairClick"/>
                            <ToggleButton x:Name="SectionWarpBtn" Content="Warps" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Padding="6,4" Click="OnSectionWarpClick"/>
                            <ToggleButton x:Name="SectionNpcBtn" Content="NPC Events" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Padding="6,4" Click="OnSectionNpcClick"/>

                            <!-- СЛОИ -->
                            <TextBlock Text="LAYERS" Foreground="White" FontWeight="Bold" FontSize="12" Margin="0,8,0,0"/>
                            <UniformGrid Columns="2">
                                <ToggleButton x:Name="Layer1Toggle" Content="L1" IsChecked="True" Height="32" Margin="1" FontWeight="Bold" Background="#4CAF50" Foreground="White" Click="OnLayer1ToggleClick"/>
                                <ToggleButton x:Name="Layer2Toggle" Content="L2" IsChecked="True" Height="32" Margin="1" FontWeight="Bold" Background="#4CAF50" Foreground="White" Click="OnLayer2ToggleClick"/>
                            </UniformGrid>

                            <!-- ЗУМ -->
                            <TextBlock Text="ZOOM" Foreground="White" FontWeight="Bold" FontSize="12" Margin="0,8,0,0"/>
                            <ComboBox x:Name="ZoomSelector" HorizontalAlignment="Stretch" SelectedIndex="2" SelectionChanged="OnZoomChanged">
                                <ComboBoxItem Content="1/4x"/>
                                <ComboBoxItem Content="1/2x"/>
                                <ComboBoxItem Content="1x"/>
                                <ComboBoxItem Content="2x"/>
                                <ComboBoxItem Content="4x"/>
                            </ComboBox>
                        </StackPanel>
                    </ScrollViewer>
                </Border>
            </Border>

            <!-- РАЗДЕЛИТЕЛЬ -->
            <Border Grid.Column="1" Background="#3E3E42" Width="4"/>

            <!-- ЦЕНТР -->
            <Grid Grid.Column="2" RowDefinitions="*,200">

                <eventEditor:EventCanvas x:Name="CanvasControl" Grid.Row="0"/>

                <Grid Grid.Row="1" ColumnDefinitions="300,4,400,4,40,4,*" Background="#252526">

                    <Border Grid.Column="0" Padding="6">
                        <ListBox x:Name="EventList" Background="#1E1E1E" BorderBrush="#3E3E42" BorderThickness="1" SelectionChanged="OnEventListSelectionChanged"/>
                    </Border>

                    <Border Grid.Column="1" Background="#3E3E42" Width="4"/>

                    <Border Grid.Column="2" Padding="8">
                        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                            <Panel>
                                <!-- ROOF -->
                                <StackPanel x:Name="RoofPanel" Spacing="3" IsVisible="False">
                                    <Grid ColumnDefinitions="100,*">
                                        <TextBlock Grid.Column="0" Text="Start X,Y:" Foreground="#CCCCCC" VerticalAlignment="Center"/>
                                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="4">
                                            <TextBox x:Name="Roof_StartX" Width="45" MaxLength="3" TextInput="OnCoordTextInput" TextChanged="OnRoofStartXChanged"/>
                                            <TextBlock Text="," VerticalAlignment="Center" Foreground="#CCCCCC"/>
                                            <TextBox x:Name="Roof_StartY" Width="45" MaxLength="3" TextInput="OnCoordTextInput" TextChanged="OnRoofStartYChanged"/>
                                        </StackPanel>
                                    </Grid>
                                    <Grid ColumnDefinitions="100,*">
                                        <TextBlock Grid.Column="0" Text="End X,Y:" Foreground="#CCCCCC" VerticalAlignment="Center"/>
                                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="4">
                                            <TextBox x:Name="Roof_EndX" Width="45" MaxLength="3" TextInput="OnCoordTextInput" TextChanged="OnRoofEndXChanged"/>
                                            <TextBlock Text="," VerticalAlignment="Center" Foreground="#CCCCCC"/>
                                            <TextBox x:Name="Roof_EndY" Width="45" MaxLength="3" TextInput="OnCoordTextInput" TextChanged="OnRoofEndYChanged"/>
                                        </StackPanel>
                                    </Grid>
                                    
                                    <Grid ColumnDefinitions="100,*" Margin="0,6,0,0">
                                        <TextBlock Grid.Column="0" Text="Triggers" Foreground="#CCCCCC" VerticalAlignment="Center" FontWeight="Bold"/>
                                        <TextBlock Grid.Column="1" x:Name="Roof_TriggersCount" Text="0 / 10" Foreground="#888888" FontSize="11" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                    </Grid>
                                    <ListBox x:Name="Roof_TriggersList" Height="60" Background="#1E1E1E" BorderBrush="#3E3E42" BorderThickness="1" SelectionChanged="OnRoofTriggerSelected">
                                        <ListBox.Styles>
                                            <Style Selector="ListBoxItem">
                                                <Setter Property="FontSize" Value="11"/>
                                                <Setter Property="MinHeight" Value="0"/>
                                                <Setter Property="Padding" Value="6,2"/>
                                            </Style>
                                        </ListBox.Styles>
                                    </ListBox>
                                    <StackPanel Orientation="Horizontal" Spacing="4">
                                        <Button Content="+ Add" MinWidth="70" FontSize="11" Padding="4,2" Click="OnRoofTriggerAdd"/>
                                        <Button Content="− Delete" MinWidth="70" FontSize="11" Padding="4,2" Click="OnRoofTriggerDelete"/>
                                    </StackPanel>
                                    <Grid ColumnDefinitions="30,*,10,30,*">
                                        <TextBlock Grid.Column="0" Text="X:" Foreground="#CCCCCC" VerticalAlignment="Center"/>
                                        <TextBox Grid.Column="1" x:Name="Roof_TriggerX" MaxLength="3" TextInput="OnCoordTextInput" TextChanged="OnRoofTriggerXChanged"/>
                                        <TextBlock Grid.Column="3" Text="Y:" Foreground="#CCCCCC" VerticalAlignment="Center"/>
                                        <TextBox Grid.Column="4" x:Name="Roof_TriggerY" MaxLength="3" TextInput="OnCoordTextInput" TextChanged="OnRoofTriggerYChanged"/>
                                    </Grid>
                                    
                                    <Grid ColumnDefinitions="100,*" Margin="0,8,0,0">
                                        <TextBlock Grid.Column="0" Text="Exits" Foreground="#CCCCCC" VerticalAlignment="Center" FontWeight="Bold"/>
                                        <TextBlock Grid.Column="1" x:Name="Roof_ExitsCount" Text="0 / 10" Foreground="#888888" FontSize="11" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                    </Grid>
                                    <ListBox x:Name="Roof_ExitsList" Height="60" Background="#1E1E1E" BorderBrush="#3E3E42" BorderThickness="1" SelectionChanged="OnRoofExitSelected">
                                        <ListBox.Styles>
                                            <Style Selector="ListBoxItem">
                                                <Setter Property="FontSize" Value="11"/>
                                                <Setter Property="MinHeight" Value="0"/>
                                                <Setter Property="Padding" Value="6,2"/>
                                            </Style>
                                        </ListBox.Styles>
                                    </ListBox>
                                    <StackPanel Orientation="Horizontal" Spacing="4">
                                        <Button Content="+ Add" MinWidth="70" FontSize="11" Padding="4,2" Click="OnRoofExitAdd"/>
                                        <Button Content="− Delete" MinWidth="70" FontSize="11" Padding="4,2" Click="OnRoofExitDelete"/>
                                    </StackPanel>
                                    <Grid ColumnDefinitions="30,*,10,30,*">
                                        <TextBlock Grid.Column="0" Text="X:" Foreground="#CCCCCC" VerticalAlignment="Center"/>
                                        <TextBox Grid.Column="1" x:Name="Roof_ExitX" MaxLength="3" TextInput="OnCoordTextInput" TextChanged="OnRoofExitXChanged"/>
                                        <TextBlock Grid.Column="3" Text="Y:" Foreground="#CCCCCC" VerticalAlignment="Center"/>
                                        <TextBox Grid.Column="4" x:Name="Roof_ExitY" MaxLength="3" TextInput="OnCoordTextInput" TextChanged="OnRoofExitYChanged"/>
                                    </Grid>
                                </StackPanel>

                                <!-- TILE CHANGE -->
                                <StackPanel x:Name="TileChangePanel" Spacing="3" IsVisible="False">
                                    <Grid ColumnDefinitions="100,*">
                                        <TextBlock Grid.Column="0" Text="Trigger X,Y:" Foreground="#CCCCCC" VerticalAlignment="Center"/>
                                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="4">
                                            <TextBox x:Name="TC_TriggerX" Width="45" MaxLength="3" TextInput="OnCoordTextInput" TextChanged="OnTCTriggerXChanged"/>
                                            <TextBlock Text="," VerticalAlignment="Center" Foreground="#CCCCCC"/>
                                            <TextBox x:Name="TC_TriggerY" Width="45" MaxLength="3" TextInput="OnCoordTextInput" TextChanged="OnTCTriggerYChanged"/>
                                        </StackPanel>
                                    </Grid>
                                    <Grid ColumnDefinitions="100,*">
                                        <TextBlock Grid.Column="0" Text="New Tile:" Foreground="#CCCCCC" VerticalAlignment="Center"/>
                                        <TextBox Grid.Column="1" x:Name="TC_NewTile" Width="70" MaxLength="5" HorizontalAlignment="Left" TextInput="OnCoordTextInput" TextChanged="OnTCNewTileChanged"/>
                                    </Grid>
                                    <Grid ColumnDefinitions="100,*">
                                        <TextBlock Grid.Column="0" Text="Close X,Y:" Foreground="#CCCCCC" VerticalAlignment="Center"/>
                                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="4">
                                            <TextBox x:Name="TC_CloseX" Width="45" MaxLength="3" TextInput="OnCoordTextInput" TextChanged="OnTCCloseXChanged"/>
                                            <TextBlock Text="," VerticalAlignment="Center" Foreground="#CCCCCC"/>
                                            <TextBox x:Name="TC_CloseY" Width="45" MaxLength="3" TextInput="OnCoordTextInput" TextChanged="OnTCCloseYChanged"/>
                                        </StackPanel>
                                    </Grid>
                                </StackPanel>

                                <!-- STAIR -->
                                <StackPanel x:Name="StairPanel" Spacing="3" IsVisible="False">
                                    <Grid ColumnDefinitions="100,*">
                                        <TextBlock Grid.Column="0" Text="Start X,Y:" Foreground="#CCCCCC" VerticalAlignment="Center"/>
                                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="4">
                                            <TextBox x:Name="St_StartX" Width="40" MaxLength="3" TextInput="OnCoordTextInput" TextChanged="OnStStartXChanged"/>
                                            <TextBlock Text="," VerticalAlignment="Center" Foreground="#CCCCCC"/>
                                            <TextBox x:Name="St_StartY" Width="40" MaxLength="3" TextInput="OnCoordTextInput" TextChanged="OnStStartYChanged"/>
                                        </StackPanel>
                                    </Grid>
                                    <Grid ColumnDefinitions="100,*">
                                        <TextBlock Grid.Column="0" Text="End X,Y:" Foreground="#CCCCCC" VerticalAlignment="Center"/>
                                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="4">
                                            <TextBox x:Name="St_EndX" Width="40" MaxLength="3" TextInput="OnCoordTextInput" TextChanged="OnStEndXChanged"/>
                                            <TextBlock Text="," VerticalAlignment="Center" Foreground="#CCCCCC"/>
                                            <TextBox x:Name="St_EndY" Width="40" MaxLength="3" TextInput="OnCoordTextInput" TextChanged="OnStEndYChanged"/>
                                        </StackPanel>
                                    </Grid>
                                    <Grid ColumnDefinitions="100,*">
                                        <TextBlock Grid.Column="0" Text="Direction:" Foreground="#CCCCCC" VerticalAlignment="Center"/>
                                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="4">
                                            <ToggleButton x:Name="St_DirLeftBtn" Content="←" Width="32" Height="24" Padding="0" FontSize="14" FontWeight="Bold" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" Click="OnStDirLeftClick"/>
                                            <ToggleButton x:Name="St_DirRightBtn" Content="→" Width="32" Height="24" Padding="0" FontSize="14" FontWeight="Bold" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" Click="OnStDirRightClick"/>
                                            <TextBlock x:Name="St_DirLabel" Text="left" VerticalAlignment="Center" Foreground="#CCCCCC" Margin="6,0,0,0"/>
                                        </StackPanel>
                                    </Grid>
                                </StackPanel>

                                <!-- WARP -->
                                <StackPanel x:Name="WarpPanel" Spacing="3" IsVisible="False">
                                    <Grid ColumnDefinitions="100,*">
                                        <TextBlock Grid.Column="0" Text="Mode:" Foreground="#CCCCCC" VerticalAlignment="Center"/>
                                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="4">
                                            <ToggleButton x:Name="W_ModeSingleBtn" Content="single" Padding="8,2"
                                                          HorizontalContentAlignment="Center" VerticalContentAlignment="Center"
                                                          Click="OnWModeSingleClick"/>
                                            <ToggleButton x:Name="W_ModeLineBtn" Content="line" Padding="8,2"
                                                          HorizontalContentAlignment="Center" VerticalContentAlignment="Center"
                                                          Click="OnWModeLineClick"/>
                                            <TextBlock x:Name="W_ModeLabel" Text="single" VerticalAlignment="Center"
                                                       Foreground="#CCCCCC" Margin="6,0,0,0"/>
                                        </StackPanel>
                                    </Grid>
                                    <Grid ColumnDefinitions="100,*">
                                        <TextBlock Grid.Column="0" Text="Trigger X,Y:" Foreground="#CCCCCC" VerticalAlignment="Center"/>
                                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="4">
                                            <TextBox x:Name="W_TriggerX" Width="40" MaxLength="3" TextInput="OnCoordTextInput" TextChanged="OnWTriggerXChanged"/>
                                            <TextBlock Text="," VerticalAlignment="Center" Foreground="#CCCCCC"/>
                                            <TextBox x:Name="W_TriggerY" Width="40" MaxLength="3" TextInput="OnCoordTextInput" TextChanged="OnWTriggerYChanged"/>
                                        </StackPanel>
                                    </Grid>
                                    <Grid x:Name="W_EndPanel" ColumnDefinitions="100,*" IsVisible="False">
                                        <TextBlock Grid.Column="0" Text="End X,Y:" Foreground="#CCCCCC" VerticalAlignment="Center"/>
                                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="4">
                                            <TextBox x:Name="W_EndX" Width="40" MaxLength="3" TextInput="OnCoordTextInput" TextChanged="OnWEndXChanged"/>
                                            <TextBlock Text="," VerticalAlignment="Center" Foreground="#CCCCCC"/>
                                            <TextBox x:Name="W_EndY" Width="40" MaxLength="3" TextInput="OnCoordTextInput" TextChanged="OnWEndYChanged"/>
                                        </StackPanel>
                                    </Grid>
                                    <Grid ColumnDefinitions="100,*">
                                        <TextBlock Grid.Column="0" Text="Target Map:" Foreground="#CCCCCC" VerticalAlignment="Center"/>
                                        <ComboBox Grid.Column="1" x:Name="W_TargetMapCombo" HorizontalAlignment="Stretch" SelectionChanged="OnWTargetMapChanged"/>
                                    </Grid>
                                    <Grid ColumnDefinitions="100,*">
                                        <TextBlock Grid.Column="0" Text="Target X,Y:" Foreground="#CCCCCC" VerticalAlignment="Center"/>
                                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="4">
                                            <TextBox x:Name="W_TargetX" Width="40" MaxLength="3" TextInput="OnCoordTextInput" TextChanged="OnWTargetXChanged"/>
                                            <TextBlock Text="," VerticalAlignment="Center" Foreground="#CCCCCC"/>
                                            <TextBox x:Name="W_TargetY" Width="40" MaxLength="3" TextInput="OnCoordTextInput" TextChanged="OnWTargetYChanged"/>
                                        </StackPanel>
                                    </Grid>
                                    <Grid ColumnDefinitions="100,*">
                                        <TextBlock Grid.Column="0" Text="Facing:" Foreground="#CCCCCC" VerticalAlignment="Center"/>
                                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="3">
                                            <ToggleButton x:Name="W_FacingDownBtn"  Content="↓" Width="28" Height="24" Padding="0" FontSize="14" FontWeight="Bold" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" Click="OnWFacingDownClick"/>
                                            <ToggleButton x:Name="W_FacingLeftBtn"  Content="←" Width="28" Height="24" Padding="0" FontSize="14" FontWeight="Bold" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" Click="OnWFacingLeftClick"/>
                                            <ToggleButton x:Name="W_FacingRightBtn" Content="→" Width="28" Height="24" Padding="0" FontSize="14" FontWeight="Bold" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" Click="OnWFacingRightClick"/>
                                            <ToggleButton x:Name="W_FacingUpBtn"    Content="↑" Width="28" Height="24" Padding="0" FontSize="14" FontWeight="Bold" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" Click="OnWFacingUpClick"/>
                                            <TextBlock x:Name="W_FacingLabel" Text="down" VerticalAlignment="Center" Foreground="#CCCCCC" Margin="6,0,0,0"/>
                                        </StackPanel>
                                    </Grid>
                                </StackPanel>

                                <!-- NPC -->
                                <StackPanel x:Name="NpcPanel" Spacing="4" IsVisible="False">
                                    <Grid ColumnDefinitions="100,*">
                                        <TextBlock Grid.Column="0" Text="ID:" Foreground="#CCCCCC" VerticalAlignment="Center"/>
                                        <TextBox Grid.Column="1" x:Name="Npc_Id" TextChanged="OnNpcIdChanged"/>
                                    </Grid>
                                    <Grid ColumnDefinitions="100,*">
                                        <TextBlock Grid.Column="0" Text="X,Y:" Foreground="#CCCCCC" VerticalAlignment="Center"/>
                                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="4">
                                            <TextBox x:Name="Npc_X" Width="40" MaxLength="4" TextInput="OnCoordTextInput" TextChanged="OnNpcXYChanged"/>
                                            <TextBlock Text="," VerticalAlignment="Center" Foreground="#CCCCCC"/>
                                            <TextBox x:Name="Npc_Y" Width="40" MaxLength="4" TextInput="OnCoordTextInput" TextChanged="OnNpcXYChanged"/>
                                        </StackPanel>
                                    </Grid>
                                    <Grid ColumnDefinitions="100,*">
                                        <TextBlock Grid.Column="0" Text="Sprite:" Foreground="#CCCCCC" VerticalAlignment="Center"/>
                                        <Grid Grid.Column="1" ColumnDefinitions="Auto,Auto,*,Auto,Auto">
                                            <Border Grid.Column="0" Width="32" Height="32" Margin="0,0,6,0" BorderBrush="#555555" BorderThickness="1" Background="#0E0E0E" ClipToBounds="True">
                                                <Image x:Name="Npc_SpritePreview" Stretch="Uniform" RenderOptions.BitmapInterpolationMode="None"/>
                                            </Border>
                                            <TextBox Grid.Column="1" x:Name="Npc_Sprite" Width="120" TextChanged="OnNpcSpriteChanged"/>
                                            <Button Grid.Column="3" Content="&lt;" Width="24" Height="24" Margin="2,0,0,0" Padding="0" Click="OnNpcSpritePrevClick"/>
                                            <Button Grid.Column="4" Content="&gt;" Width="24" Height="24" Margin="2,0,0,0" Padding="0" Click="OnNpcSpriteNextClick"/>
                                        </Grid>
                                    </Grid>
                                    
                                    <!-- МЕНЯЕМ ColumnDefinitions (ширина для wander) -->
                                    <Grid ColumnDefinitions="90,140,10,90,*">
                                        <TextBlock Grid.Column="0" Text="Behavior:" Foreground="#CCCCCC" VerticalAlignment="Center"/>
                                        <ComboBox Grid.Column="1" x:Name="Npc_Behavior" HorizontalAlignment="Stretch" SelectionChanged="OnNpcBehaviorChanged">
                                            <ComboBoxItem Content="static"/>
                                            <ComboBoxItem Content="wander"/>
                                        </ComboBox>
                                        
                                        <TextBlock Grid.Column="3" Text="Direction:" Foreground="#CCCCCC" VerticalAlignment="Center"/>
                                        <ComboBox Grid.Column="4" x:Name="Npc_Direction" HorizontalAlignment="Stretch" SelectionChanged="OnNpcDirectionChanged">
                                            <ComboBoxItem Content="down"/>
                                            <ComboBoxItem Content="left"/>
                                            <ComboBoxItem Content="right"/>
                                            <ComboBoxItem Content="up"/>
                                        </ComboBox>
                                    </Grid>

                                    <!-- ДОБАВЛЯЕМ x:Name="Npc_WanderPanel" -->
                                    <Grid x:Name="Npc_WanderPanel" ColumnDefinitions="100,*,10,100,50">
                                        <TextBlock Grid.Column="0" Text="Home X,Y:" Foreground="#CCCCCC" VerticalAlignment="Center"/>
                                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="4">
                                            <TextBox x:Name="Npc_HomeX" Width="40" MaxLength="4" TextInput="OnCoordTextInput" TextChanged="OnNpcHomeXYChanged"/>
                                            <TextBlock Text="," VerticalAlignment="Center" Foreground="#CCCCCC"/>
                                            <TextBox x:Name="Npc_HomeY" Width="40" MaxLength="4" TextInput="OnCoordTextInput" TextChanged="OnNpcHomeXYChanged"/>
                                        </StackPanel>
                                        
                                        <TextBlock Grid.Column="3" Text="Radius:" Foreground="#CCCCCC" VerticalAlignment="Center"/>
                                        <TextBox Grid.Column="4" x:Name="Npc_Radius" MaxLength="3" TextInput="OnCoordTextInput" TextChanged="OnNpcRadiusChanged"/>
                                    </Grid>
                                    
                                    <Grid ColumnDefinitions="100,*">
                                        <TextBlock Grid.Column="0" Text="Script:" Foreground="#CCCCCC" VerticalAlignment="Center"/>
                                        <Grid Grid.Column="1" RowDefinitions="120,Auto" RowSpacing="4">
                                            <ListBox Grid.Row="0" x:Name="Npc_ScriptList" Background="#1E1E1E" BorderBrush="#3E3E42" BorderThickness="1" SelectionChanged="OnNpcScriptSelected"/>
                                            <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="4">
                                                <Button Content="+ Step" Width="60" FontSize="11" Click="OnNpcScriptAdd"/>
                                                <Button Content="- Step" Width="60" FontSize="11" Click="OnNpcScriptRemove"/>
                                            </StackPanel>
                                        </Grid>
                                    </Grid>
                                    
                                </StackPanel>
                            </Panel>
                        </ScrollViewer>
                    </Border>

                    <Border Grid.Column="3" Background="#3E3E42" Width="4"/>

                    <StackPanel Grid.Column="4" Spacing="4" VerticalAlignment="Top" Margin="0,8,0,0">
                        <Button x:Name="AddBtn" Content="+" Width="28" Height="28" Padding="0" FontSize="18" FontWeight="Bold" Click="OnAddClick"/>
                        <Button x:Name="RemoveBtn" Content="−" Width="28" Height="28" Padding="0" FontSize="18" FontWeight="Bold" Click="OnRemoveClick"/>
                    </StackPanel>

                    <Border Grid.Column="5" Background="#3E3E42" Width="4"/>

                    <Border Grid.Column="6" Padding="8" Background="#1E1E1E">
                        <StackPanel Spacing="8">
                            <TextBlock Text="SCRIPT INSPECTOR" Foreground="White" FontWeight="Bold" FontSize="12"/>
                            
                            <!-- Выбор типа команды -->
                            <Grid ColumnDefinitions="60,*">
                                <TextBlock Grid.Column="0" Text="Type:" Foreground="#CCCCCC" VerticalAlignment="Center"/>
                                <ComboBox Grid.Column="1" x:Name="Npc_ScriptType" HorizontalAlignment="Stretch" SelectionChanged="OnNpcScriptTypeChanged">
                                    <ComboBoxItem Content="say"/>
                                    <ComboBoxItem Content="turn_to_player"/>
                                    <ComboBoxItem Content="turn_player_to_npc"/>
                                    <ComboBoxItem Content="open_shop"/>
                                    <ComboBoxItem Content="start_battle"/>
                                    <ComboBoxItem Content="end"/>
                                </ComboBox>
                            </Grid>

                            <!-- Поле параметра (TextBox для ID магазина/битвы) -->
                            <Grid ColumnDefinitions="60,*">
                                <TextBlock Grid.Column="0" x:Name="Npc_ScriptParamLabel" Text="Param:" Foreground="#CCCCCC" VerticalAlignment="Center"/>
                                <Grid Grid.Column="1">
                                    <!-- Поле для магазинов и битв -->
                                    <TextBox x:Name="Npc_ScriptParam" TextChanged="OnNpcScriptParamChanged" IsVisible="True" Width="45" MaxLength="3" HorizontalAlignment="Left" TextInput="OnCoordTextInput"/>
                                    
                                    <!-- ★ НОВАЯ ПАНЕЛЬ ДЛЯ ТЕКСТОВ ★ -->
                                    <StackPanel x:Name="Npc_TextIdPanel" IsVisible="False" Spacing="4">
                                        <!-- Сюда будут добавляться теги [0001] -->
                                        <WrapPanel x:Name="Npc_TextIdsWrapPanel" Orientation="Horizontal" />
                                        
                                        <!-- Выпадающий список и кнопки + / - -->
                                        <Grid ColumnDefinitions="*,Auto">
                                            <ComboBox x:Name="Npc_ScriptTextCombo" Grid.Column="0" HorizontalAlignment="Stretch" SelectionChanged="OnNpcScriptTextSelected"/>
                                            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="2">
                                                <Button Content="+" Width="24" Height="24" Padding="0" FontSize="14" FontWeight="Bold" Click="OnTextIdAddClick"/>
                                                <Button Content="-" Width="24" Height="24" Padding="0" FontSize="14" FontWeight="Bold" Click="OnTextIdRemoveClick"/>
                                            </StackPanel>
                                        </Grid>
                                    </StackPanel>
                                </Grid>
                            </Grid>
                            
                        </StackPanel>
                    </Border>
                    
                </Grid>
            </Grid>
        </Grid>
    </Panel>
</UserControl>