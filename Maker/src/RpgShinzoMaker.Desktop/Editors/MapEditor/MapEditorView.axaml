<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="using:RpgShinzoMaker.Desktop.Views"
             xmlns:mapEditor="using:RpgShinzoMaker.Desktop.Editors.MapEditor"
             x:Class="RpgShinzoMaker.Desktop.Editors.MapEditor.MapEditorView">

    <UserControl.Styles>
        <!-- Мигание выбранной иконки типа в Mode B -->
        <Style Selector="Border.typeIcon.selected">
            <Style.Animations>
                <Animation Duration="0:0:0.8" IterationCount="Infinite">
                    <KeyFrame Cue="0%"><Setter Property="Opacity" Value="1"/></KeyFrame>
                    <KeyFrame Cue="50%"><Setter Property="Opacity" Value="0.25"/></KeyFrame>
                    <KeyFrame Cue="100%"><Setter Property="Opacity" Value="1"/></KeyFrame>
                </Animation>
            </Style.Animations>
        </Style>

        <!-- Скроллбары -->
        <Style Selector="ScrollBar">
            <Setter Property="Opacity" Value="1"/>
            <Setter Property="Background" Value="#1E1E1E"/>
        </Style>
        <Style Selector="ScrollBar:vertical">
            <Setter Property="Width" Value="10"/>
        </Style>
        <Style Selector="ScrollBar:horizontal">
            <Setter Property="Height" Value="10"/>
        </Style>
        <Style Selector="ScrollBar /template/ Thumb">
            <Setter Property="Background" Value="#007ACC"/>
            <Setter Property="Opacity" Value="1"/>
        </Style>
        <Style Selector="ScrollBar /template/ Thumb:pointerover">
            <Setter Property="Background" Value="#1E90FF"/>
        </Style>
        <Style Selector="ScrollBar /template/ Thumb:pressed">
            <Setter Property="Background" Value="#005A9E"/>
        </Style>
    </UserControl.Styles>

    <Panel>

        <Grid ColumnDefinitions="305,4,*,4,192">

            <!-- ═══════════════════════════════════════════════════════ -->
            <!-- КОЛОНКА 0: БЛОКСЕТ -->
            <!-- ═══════════════════════════════════════════════════════ -->
            <Border Grid.Column="0" Background="#252526" Padding="8">
                <Border Background="#1E1E1E"
                        BorderBrush="#3E3E42"
                        BorderThickness="1"
                        CornerRadius="4">
                    <Grid Margin="8" RowDefinitions="Auto,Auto,Auto,384,Auto,Auto">

                        <TextBlock Grid.Row="0"
                                   Text="BLOCKSET"
                                   Foreground="White"
                                   FontWeight="Bold"
                                   Margin="0,0,0,8"/>

                        <Button Grid.Row="1"
                                Content="Load Tileset"
                                HorizontalAlignment="Stretch"
                                Margin="0,0,0,8"
                                Click="OnLoadTilesetClick"/>

                        <Grid Grid.Row="2" ColumnDefinitions="*,*" Margin="0,0,0,8">
                            <ToggleButton x:Name="ModeA"
                                          Grid.Column="0"
                                          Content="A"
                                          IsChecked="True"
                                          HorizontalAlignment="Stretch"
                                          HorizontalContentAlignment="Center"
                                          Margin="0,0,2,0"
                                          Click="OnModeAClick"/>
                            <ToggleButton x:Name="ModeB"
                                          Grid.Column="1"
                                          Content="B"
                                          HorizontalAlignment="Stretch"
                                          HorizontalContentAlignment="Center"
                                          Margin="2,0,0,0"
                                          Click="OnModeBClick"/>
                        </Grid>

                        <!-- ПАЛИТРА ТАЙЛОВ -->
                        <ListBox x:Name="PaletteList"
                                 Grid.Row="3"
                                 Height="384"
                                 HorizontalAlignment="Stretch"
                                 VerticalAlignment="Top"
                                 Background="#1E1E1E"
                                 BorderThickness="0"
                                 Padding="0"
                                 SelectionChanged="OnPaletteSelectionChanged"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                 ScrollViewer.VerticalScrollBarVisibility="Visible"
                                 ScrollViewer.AllowAutoHide="False">
                            <ListBox.Styles>
                                <Style Selector="ListBoxItem">
                                    <Setter Property="Padding" Value="0"/>
                                    <Setter Property="Margin" Value="0"/>
                                    <Setter Property="MinHeight" Value="0"/>
                                    <Setter Property="MinWidth" Value="0"/>
                                    <Setter Property="HorizontalContentAlignment" Value="Left"/>
                                    <Setter Property="VerticalContentAlignment" Value="Top"/>
                                </Style>
                                <Style Selector="ListBoxItem /template/ ContentPresenter">
                                    <Setter Property="Background" Value="Transparent"/>
                                    <Setter Property="BorderThickness" Value="0"/>
                                    <Setter Property="Padding" Value="0"/>
                                    <Setter Property="CornerRadius" Value="0"/>
                                </Style>
                                <Style Selector="ListBoxItem:pointerover /template/ ContentPresenter">
                                    <Setter Property="Background" Value="Transparent"/>
                                </Style>
                                <Style Selector="ListBoxItem:selected /template/ ContentPresenter">
                                    <Setter Property="Background" Value="Transparent"/>
                                </Style>
                            </ListBox.Styles>
                            <ListBox.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel Orientation="Horizontal"
                                               Width="256"
                                               HorizontalAlignment="Left"/>
                                </ItemsPanelTemplate>
                            </ListBox.ItemsPanel>
                            <ListBox.ItemTemplate>
                                <DataTemplate DataType="mapEditor:TileItem">
                                    <Grid Width="32" Height="32"
                                          Background="#1E1E1E"
                                          ClipToBounds="True"
                                          Tag="{Binding}"
                                          PointerPressed="OnPaletteItemPointerPressed"
                                          PointerMoved="OnPaletteItemPointerMoved">
                                        <Image Source="{Binding Image}"
                                               Stretch="Fill"
                                               RenderOptions.BitmapInterpolationMode="None"
                                               RenderOptions.EdgeMode="Aliased"
                                               IsHitTestVisible="False"/>
                                        <Border BorderBrush="#3E3E42"
                                                BorderThickness="0,0,1,1"
                                                IsHitTestVisible="False"/>
                                        <Border Width="8" Height="8"
                                                HorizontalAlignment="Right"
                                                VerticalAlignment="Bottom"
                                                Margin="0,0,1,1"
                                                CornerRadius="4"
                                                Background="{Binding TileColor}"
                                                IsVisible="{Binding ShowType}"
                                                IsHitTestVisible="False"/>
                                        <Border BorderBrush="#FFD700"
                                                BorderThickness="2"
                                                IsVisible="{Binding LeftSelected}"
                                                IsHitTestVisible="False"/>
                                        <Border BorderBrush="#FF2222"
                                                BorderThickness="2"
                                                IsVisible="{Binding RightSelected}"
                                                IsHitTestVisible="False"/>
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>

                        <!-- ПРЕВЬЮ: A → два квадрата, B → круг -->
                        <Border Grid.Row="4"
                                Background="#1E1E1E"
                                BorderBrush="#3E3E42"
                                BorderThickness="1"
                                CornerRadius="3"
                                Margin="0,8,0,0"
                                Padding="8">
                            <Grid>
                                <Grid x:Name="ModeAPreviewGrid" ColumnDefinitions="*,*">
                                    <StackPanel Grid.Column="0" Spacing="4" HorizontalAlignment="Center">
                                        <TextBlock Text="Left click"
                                                   Foreground="#AAAAAA"
                                                   FontSize="10"
                                                   HorizontalAlignment="Center"/>
                                        <Border CornerRadius="10"
                                                BorderBrush="#555555"
                                                BorderThickness="1"
                                                Width="60" Height="60"
                                                HorizontalAlignment="Center"
                                                Background="#0E0E0E"
                                                ClipToBounds="True">
                                            <Image x:Name="LeftClickPreview"
                                                   Stretch="Fill"
                                                   RenderOptions.BitmapInterpolationMode="None"
                                                   RenderOptions.EdgeMode="Aliased"/>
                                        </Border>
                                        <TextBlock x:Name="LeftClickLabel"
                                                   Text="—"
                                                   Foreground="#888888"
                                                   FontSize="10"
                                                   HorizontalAlignment="Center"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Spacing="4" HorizontalAlignment="Center">
                                        <TextBlock Text="Right click"
                                                   Foreground="#AAAAAA"
                                                   FontSize="10"
                                                   HorizontalAlignment="Center"/>
                                        <Border CornerRadius="10"
                                                BorderBrush="#555555"
                                                BorderThickness="1"
                                                Width="60" Height="60"
                                                HorizontalAlignment="Center"
                                                Background="#0E0E0E"
                                                ClipToBounds="True">
                                            <Image x:Name="RightClickPreview"
                                                   Stretch="Fill"
                                                   RenderOptions.BitmapInterpolationMode="None"
                                                   RenderOptions.EdgeMode="Aliased"/>
                                        </Border>
                                        <TextBlock x:Name="RightClickLabel"
                                                   Text="—"
                                                   Foreground="#888888"
                                                   FontSize="10"
                                                   HorizontalAlignment="Center"/>
                                    </StackPanel>
                                </Grid>

                                <StackPanel x:Name="ModeBPreviewPanel"
                                            Spacing="4"
                                            HorizontalAlignment="Center"
                                            IsVisible="False">
                                    <TextBlock Text="Selected type"
                                               Foreground="#AAAAAA"
                                               FontSize="10"
                                               HorizontalAlignment="Center"/>
                                    <Border CornerRadius="30"
                                            BorderBrush="#555555"
                                            BorderThickness="1"
                                            Width="60" Height="60"
                                            HorizontalAlignment="Center"
                                            Background="#0E0E0E">
                                        <Ellipse x:Name="TypePreviewEllipse"
                                                 Width="40" Height="40"
                                                 Fill="#4CAF50"
                                                 HorizontalAlignment="Center"
                                                 VerticalAlignment="Center"/>
                                    </Border>
                                    <TextBlock x:Name="TypePreviewLabel"
                                               Text="Passable"
                                               Foreground="#888888"
                                               FontSize="10"
                                               HorizontalAlignment="Center"/>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <!-- НИЖНЯЯ ПАНЕЛЬ БЛОКСЕТА -->
                        <Border Grid.Row="5"
                                Background="#252526"
                                BorderBrush="#3E3E42"
                                BorderThickness="0,1,0,0"
                                Padding="8,4"
                                Margin="0,8,0,0">
                            <StackPanel Spacing="4">

                                <Grid ColumnDefinitions="Auto,Auto,*,Auto">
                                    <TextBlock x:Name="PaletteStatus"
                                               Grid.Column="0"
                                               Text="✗"
                                               Foreground="#E74C3C"
                                               FontSize="14"
                                               FontWeight="Bold"
                                               VerticalAlignment="Center"
                                               Margin="0,0,6,0"/>
                                    <TextBlock x:Name="PaletteInfo"
                                               Grid.Column="1"
                                               Text="Тайлов: 0"
                                               Foreground="#AAAAAA"
                                               FontSize="12"
                                               VerticalAlignment="Center"/>
                                    <TextBlock Grid.Column="3"
                                               Text="48×48"
                                               Foreground="#666666"
                                               FontSize="12"
                                               VerticalAlignment="Center"/>
                                </Grid>

                                <Border Background="#1E1E1E"
                                        BorderBrush="#3E3E42"
                                        BorderThickness="1"
                                        CornerRadius="3"
                                        Padding="4,3">
                                    <Grid ColumnDefinitions="Auto,Auto,*,Auto,Auto,Auto,Auto">
                                        <TextBlock Grid.Column="0"
                                                   Text="Grid"
                                                   Foreground="#AAAAAA"
                                                   FontSize="11"
                                                   VerticalAlignment="Center"
                                                   Margin="0,0,6,0"/>
                                        <ToggleButton x:Name="GridModeToggle"
                                                      Grid.Column="1"
                                                      Content="OFF"
                                                      FontSize="10"
                                                      Padding="6,1"
                                                      MinHeight="0"
                                                      Click="OnGridModeClick"/>
                                        <Border Grid.Column="3"
                                                x:Name="TypeIcon0"
                                                Classes="typeIcon"
                                                Width="18" Height="18"
                                                Background="#4CAF50"
                                                Margin="2,0"
                                                BorderBrush="#FFFFFF"
                                                BorderThickness="2"
                                                CornerRadius="9"
                                                Cursor="Hand"
                                                Tag="0"
                                                PointerPressed="OnTileTypeClick"/>
                                        <Border Grid.Column="4"
                                                x:Name="TypeIcon1"
                                                Classes="typeIcon"
                                                Width="18" Height="18"
                                                Background="#E74C3C"
                                                Margin="2,0"
                                                BorderBrush="#555555"
                                                BorderThickness="2"
                                                CornerRadius="9"
                                                Cursor="Hand"
                                                Tag="1"
                                                PointerPressed="OnTileTypeClick"/>
                                        <Border Grid.Column="5"
                                                x:Name="TypeIcon2"
                                                Classes="typeIcon"
                                                Width="18" Height="18"
                                                Background="#3498DB"
                                                Margin="2,0"
                                                BorderBrush="#555555"
                                                BorderThickness="2"
                                                CornerRadius="9"
                                                Cursor="Hand"
                                                Tag="2"
                                                PointerPressed="OnTileTypeClick"/>
                                        <Border Grid.Column="6"
                                                x:Name="TypeIcon3"
                                                Classes="typeIcon"
                                                Width="18" Height="18"
                                                Background="#E67E22"
                                                Margin="2,0"
                                                BorderBrush="#555555"
                                                BorderThickness="2"
                                                CornerRadius="9"
                                                Cursor="Hand"
                                                Tag="3"
                                                PointerPressed="OnTileTypeClick"/>
                                    </Grid>
                                </Border>
                            </StackPanel>
                        </Border>
                    </Grid>
                </Border>
            </Border>

            <!-- ═══════════════════════════════════════════════════════ -->
            <!-- РАЗДЕЛИТЕЛЬ 1 (только визуальный, без ресайза) -->
            <!-- ═══════════════════════════════════════════════════════ -->
            <Border Grid.Column="1"
                    Background="#3E3E42"
                    Width="4"/>

            <!-- ═══════════════════════════════════════════════════════ -->
            <!-- КОЛОНКА 2: КАНВАС КАРТЫ + НИЖНЯЯ ПАНЕЛЬ -->
            <!-- ═══════════════════════════════════════════════════════ -->
            <Grid Grid.Column="2" RowDefinitions="*,Auto">
                <views:MapCanvas x:Name="MapCanvasControl" Grid.Row="0"/>

                <Border Grid.Row="1" Background="#252526" Padding="8,6">
                    <StackPanel Orientation="Horizontal" Spacing="12">
                        <TextBlock Text="Карта:" Foreground="White" VerticalAlignment="Center"/>
                        <ComboBox x:Name="MapSelector"
                                  MinWidth="180"
                                  VerticalAlignment="Center"
                                  SelectionChanged="OnMapSelectorChanged"/>
                        <TextBlock Text="Размер:" Foreground="White" VerticalAlignment="Center"/>
                        <TextBlock x:Name="MapSizeText"
                                   Text="—"
                                   Foreground="#4CAF50"
                                   VerticalAlignment="Center"/>
                        <TextBlock Text="Тайлсет:" Foreground="White" VerticalAlignment="Center"/>
                        <TextBlock x:Name="MapTilesetText"
                                   Text="—"
                                   Foreground="#4CAF50"
                                   VerticalAlignment="Center"/>
                        <TextBlock Text="Музыка:" Foreground="White" VerticalAlignment="Center"/>
                        <ComboBox x:Name="MapMusicSelector"
                                  MinWidth="180"
                                  VerticalAlignment="Center"
                                  SelectionChanged="OnMapMusicChanged"/>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- ═══════════════════════════════════════════════════════ -->
            <!-- РАЗДЕЛИТЕЛЬ 2 (только визуальный, без ресайза) -->
            <!-- ═══════════════════════════════════════════════════════ -->
            <Border Grid.Column="3"
                    Background="#3E3E42"
                    Width="4"/>

            <!-- ═══════════════════════════════════════════════════════ -->
            <!-- КОЛОНКА 4: ПАНЕЛЬ ИНСТРУМЕНТОВ -->
            <!-- ═══════════════════════════════════════════════════════ -->
            <Border Grid.Column="4" Background="#252526" Padding="8">
                <Border Background="#1E1E1E"
                        BorderBrush="#3E3E42"
                        BorderThickness="1"
                        CornerRadius="4">
                    <DockPanel Margin="8">
                        <TextBlock DockPanel.Dock="Top"
                                   Text="TOOLS"
                                   Foreground="White"
                                   FontWeight="Bold"
                                   FontSize="12"
                                   Margin="0,0,0,10"/>

                        <StackPanel Spacing="6"
                                    VerticalAlignment="Top"
                                    HorizontalAlignment="Stretch">

                            <!-- Ряд 1: L1 / L2 / Active Layer -->
                            <UniformGrid Columns="3">
                                <ToggleButton x:Name="Layer1Toggle"
                                              Content="L1"
                                              FontSize="14" FontWeight="Bold"
                                              Width="48" Height="40" Margin="1"
                                              IsChecked="True"
                                              Background="#4CAF50" Foreground="White"
                                              Click="OnLayer1ToggleClick"/>
                                <ToggleButton x:Name="Layer2Toggle"
                                              Content="L2"
                                              FontSize="14" FontWeight="Bold"
                                              Width="48" Height="40" Margin="1"
                                              IsChecked="True"
                                              Background="#4CAF50" Foreground="White"
                                              Click="OnLayer2ToggleClick"/>
                                <Button x:Name="ActiveLayerButton"
                                        Content="1"
                                        FontSize="14" FontWeight="Bold"
                                        Width="48" Height="40" Margin="1"
                                        Background="#6497C8" Foreground="White"
                                        Click="OnActiveLayerClick"/>
                            </UniformGrid>

                            <!-- Ряд 2: Tile Editor -->
                            <ToggleButton x:Name="TileEditorToggle"
                                          FontSize="12" FontWeight="Bold"
                                          Height="32"
                                          HorizontalAlignment="Stretch"
                                          HorizontalContentAlignment="Center"
                                          Click="OnTileEditorToggle">
                                <StackPanel Orientation="Horizontal"
                                            Spacing="6"
                                            HorizontalAlignment="Center">
                                    <TextBlock x:Name="TileEditorIcon"
                                               Text="✗"
                                               FontSize="16"
                                               FontWeight="Bold"
                                               Foreground="#E74C3C"
                                               VerticalAlignment="Center"/>
                                    <TextBlock Text="Tile Editor"
                                               VerticalAlignment="Center"/>
                                </StackPanel>
                            </ToggleButton>

                            <!-- Ряд 3: 4 кнопки трансформации (2x2) -->
                            <UniformGrid Columns="2">
                                <Button x:Name="RotateBtn"
                                        Content="🔄" FontSize="26"
                                        Width="72" Height="72" Margin="1"
                                        IsEnabled="False"
                                        BorderThickness="3" BorderBrush="#3E3E42"
                                        Click="OnRotateClick"/>
                                <Button x:Name="FlipHBtn"
                                        Width="72" Height="72" Margin="1"
                                        IsEnabled="False"
                                        BorderThickness="3" BorderBrush="#3E3E42"
                                        Click="OnFlipHClick">
                                    <TextBlock Text="↕" FontSize="26">
                                        <TextBlock.RenderTransform>
                                            <RotateTransform Angle="90"/>
                                        </TextBlock.RenderTransform>
                                    </TextBlock>
                                </Button>
                                <Button x:Name="FlipVBtn"
                                        Content="↕" FontSize="26"
                                        Width="72" Height="72" Margin="1"
                                        IsEnabled="False"
                                        BorderThickness="3" BorderBrush="#3E3E42"
                                        Click="OnFlipVClick"/>
                                <Button x:Name="DeleteBtn"
                                        Content="❌" FontSize="26"
                                        Width="72" Height="72" Margin="1"
                                        IsEnabled="False"
                                        BorderThickness="3" BorderBrush="#3E3E42"
                                        Click="OnDeleteClick"/>
                            </UniformGrid>

                            <!-- Ряд 4: Left / Right preview (для карты) -->
                            <UniformGrid Columns="2" Margin="0,6,0,0">
                                <StackPanel Spacing="2" HorizontalAlignment="Center">
                                    <TextBlock Text="Left click"
                                               Foreground="#AAAAAA"
                                               FontSize="10"
                                               HorizontalAlignment="Center"/>
                                    <Border Width="60" Height="60"
                                            CornerRadius="10"
                                            BorderBrush="#555555"
                                            BorderThickness="1"
                                            Background="#0E0E0E"
                                            ClipToBounds="True">
                                        <Image x:Name="MapLeftPreview"
                                               Stretch="Fill"
                                               RenderOptions.BitmapInterpolationMode="None"
                                               RenderOptions.EdgeMode="Aliased"/>
                                    </Border>
                                    <TextBlock x:Name="MapLeftLabel"
                                               Text="—"
                                               Foreground="#888888"
                                               FontSize="10"
                                               HorizontalAlignment="Center"/>
                                </StackPanel>
                                <StackPanel Spacing="2" HorizontalAlignment="Center">
                                    <TextBlock Text="Right click"
                                               Foreground="#AAAAAA"
                                               FontSize="10"
                                               HorizontalAlignment="Center"/>
                                    <Border Width="60" Height="60"
                                            CornerRadius="10"
                                            BorderBrush="#555555"
                                            BorderThickness="1"
                                            Background="#0E0E0E"
                                            ClipToBounds="True">
                                        <Image x:Name="MapRightPreview"
                                               Stretch="Fill"
                                               RenderOptions.BitmapInterpolationMode="None"
                                               RenderOptions.EdgeMode="Aliased"/>
                                    </Border>
                                    <TextBlock x:Name="MapRightLabel"
                                               Text="—"
                                               Foreground="#888888"
                                               FontSize="10"
                                               HorizontalAlignment="Center"/>
                                </StackPanel>
                            </UniformGrid>

                            <!-- Ряд 5: Grid Mode -->
                            <ToggleButton x:Name="GridModeButton"
                                          Content="Grid Mode"
                                          FontSize="12" FontWeight="Bold"
                                          Height="30" Margin="0,4,0,0"
                                          HorizontalAlignment="Stretch"
                                          HorizontalContentAlignment="Center"
                                          Background="#3E3E42"
                                          Foreground="White"
                                          Click="OnGridModeToggle"/>

                            <!-- Ряд 6: Zoom -->
                            <StackPanel Orientation="Horizontal"
                                        Margin="0,4,0,0"
                                        Spacing="6"
                                        HorizontalAlignment="Center">
                                <TextBlock Text="Zoom"
                                           VerticalAlignment="Center"
                                           Foreground="#AAAAAA"
                                           FontSize="12"/>
                                <ComboBox x:Name="ZoomSelector"
                                          Width="100"
                                          Height="28"
                                          SelectedIndex="2"
                                          SelectionChanged="OnZoomChanged">
                                    <ComboBoxItem Content="1/4x"/>
                                    <ComboBoxItem Content="1/2x"/>
                                    <ComboBoxItem Content="1x"/>
                                    <ComboBoxItem Content="2x"/>
                                    <ComboBoxItem Content="4x"/>
                                </ComboBox>
                            </StackPanel>
                            
                            <!-- Ряд 7: Select -->
                            <ToggleButton x:Name="SelectButton"
                                          FontSize="12" FontWeight="Bold"
                                          Height="30" Margin="0,3,0,0"
                                          Padding="0"
                                          HorizontalAlignment="Stretch"
                                          HorizontalContentAlignment="Center"
                                          Background="#3E3E42"
                                          Foreground="White"
                                          Click="OnSelectToggle">
                                <StackPanel Orientation="Horizontal"
                                            Spacing="8"
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center">
                                    <TextBlock Text="Select"
                                               VerticalAlignment="Center"/>
                                    <Image Source="avares://RpgShinzoMaker.Desktop/Assets/icons/select.png"
                                           Width="18"
                                           Height="18"
                                           Stretch="Uniform"
                                           VerticalAlignment="Center"
                                           RenderOptions.BitmapInterpolationMode="None"
                                           RenderOptions.EdgeMode="Aliased"/>
                                </StackPanel>
                            </ToggleButton>

                            <!-- Ряд 8: Areas -->
                            <Button x:Name="AreasBtn"
                                    Content="Areas"
                                    FontSize="12" FontWeight="Bold"
                                    Height="32" Margin="0,4,0,0"
                                    Padding="0"
                                    HorizontalAlignment="Stretch"
                                    HorizontalContentAlignment="Center"
                                    Click="OnAreasClick"/>

                            <!-- Ряд 9: New Map -->
                            <Button x:Name="NewMapBtn"
                                    Content="New Map"
                                    FontSize="12" FontWeight="Bold"
                                    Height="32" Margin="0,4,0,0"
                                    Padding="0"
                                    HorizontalAlignment="Stretch"
                                    HorizontalContentAlignment="Center"
                                    Click="OnNewMapClick"/>

                            <!-- Ряд 10: Rename Map -->
                            <Button x:Name="RenameMapBtn"
                                    Content="Rename Map"
                                    FontSize="12" FontWeight="Bold"
                                    Height="32" Margin="0,4,0,0"
                                    Padding="0"
                                    HorizontalAlignment="Stretch"
                                    HorizontalContentAlignment="Center"
                                    Click="OnRenameMapClick"/>

                            <!-- Ряд 11: Delete Map -->
                            <Button x:Name="DeleteMapBtn"
                                    Content="Delete Map"
                                    FontSize="12" FontWeight="Bold"
                                    Height="32" Margin="0,4,0,0"
                                    Padding="0"
                                    HorizontalAlignment="Stretch"
                                    HorizontalContentAlignment="Center"
                                    Click="OnDeleteMapClick"/>

                            <!-- Ряд 12: Resize Map -->
                            <Button x:Name="ResizeMapBtn"
                                    Content="Resize Map"
                                    FontSize="12" FontWeight="Bold"
                                    Height="32" Margin="0,4,0,0"
                                    Padding="0"
                                    HorizontalAlignment="Stretch"
                                    HorizontalContentAlignment="Center"
                                    Click="OnResizeMapClick"/>
                            
                        </StackPanel>
                    </DockPanel>
                </Border>
            </Border>
        </Grid>

        <!-- ═══════════════════════════════════════════════════════════ -->
        <!-- ОВЕРЛЕЙ: Areas                                              -->
        <!-- ═══════════════════════════════════════════════════════════ -->
        <Panel x:Name="AreasOverlay"
               IsVisible="False"
               Background="#80000000">
            <Border Width="420"
                    Background="#2D2D30"
                    BorderBrush="#555555"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="20"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center">
                <StackPanel Spacing="12">
                    <TextBlock Text="Areas"
                               FontSize="16" FontWeight="Bold"
                               Foreground="White"/>

                    <Grid ColumnDefinitions="80,*,80,*"
                          RowDefinitions="Auto,Auto"
                          RowSpacing="10" ColumnSpacing="10">
                        <TextBlock Grid.Row="0" Grid.Column="0"
                                   Text="Start X:"
                                   Foreground="#CCCCCC"
                                   VerticalAlignment="Center"/>
                        <NumericUpDown Grid.Row="0" Grid.Column="1"
                                       x:Name="AreaStartX"
                                       Minimum="0"
                                       FormatString="0"
                                       Increment="1"/>

                        <TextBlock Grid.Row="0" Grid.Column="2"
                                   Text="Start Y:"
                                   Foreground="#CCCCCC"
                                   VerticalAlignment="Center"/>
                        <NumericUpDown Grid.Row="0" Grid.Column="3"
                                       x:Name="AreaStartY"
                                       Minimum="0"
                                       FormatString="0"
                                       Increment="1"/>

                        <TextBlock Grid.Row="1" Grid.Column="0"
                                   Text="Width:"
                                   Foreground="#CCCCCC"
                                   VerticalAlignment="Center"/>
                        <NumericUpDown Grid.Row="1" Grid.Column="1"
                                       x:Name="AreaWidth"
                                       Minimum="2"
                                       FormatString="0"
                                       Increment="1"/>

                        <TextBlock Grid.Row="1" Grid.Column="2"
                                   Text="Height:"
                                   Foreground="#CCCCCC"
                                   VerticalAlignment="Center"/>
                        <NumericUpDown Grid.Row="1" Grid.Column="3"
                                       x:Name="AreaHeight"
                                       Minimum="2"
                                       FormatString="0"
                                       Increment="1"/>
                    </Grid>

                    <TextBlock x:Name="AreaError"
                               Foreground="#E74C3C"
                               FontSize="11"
                               TextWrapping="Wrap"
                               IsVisible="False"/>

                    <StackPanel Orientation="Horizontal"
                                Spacing="8"
                                HorizontalAlignment="Right">
                        <Button Content="Cancel"
                                MinWidth="90"
                                Click="OnAreasCancelClick"/>
                        <Button Content="OK"
                                MinWidth="90"
                                FontWeight="Bold"
                                Background="#4CAF50"
                                Foreground="White"
                                Click="OnAreasOkClick"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Panel>

        <!-- ═══════════════════════════════════════════════════════════ -->
        <!-- ОВЕРЛЕЙ: New Map                                            -->
        <!-- ═══════════════════════════════════════════════════════════ -->
        <Panel x:Name="NewMapOverlay"
               IsVisible="False"
               Background="#80000000">
            <Border Width="420"
                    Background="#2D2D30"
                    BorderBrush="#555555"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="20"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center">
                <StackPanel Spacing="12">
                    <TextBlock Text="New Map"
                               FontSize="16" FontWeight="Bold"
                               Foreground="White"/>

                    <Grid ColumnDefinitions="80,*">
                        <TextBlock Grid.Column="0"
                                   Text="Name:"
                                   Foreground="#CCCCCC"
                                   VerticalAlignment="Center"/>
                        <TextBox Grid.Column="1"
                                 x:Name="NewMapName"
                                 Text="map00"
                                 TextInput="OnNewMapNameTextInput"/>
                    </Grid>

                    <TextBlock Text="Map Size"
                               FontSize="11" FontWeight="Bold"
                               Foreground="#888888"
                               Margin="0,4,0,0"/>

                    <Grid ColumnDefinitions="80,*,20,80,*">
                        <TextBlock Grid.Column="0"
                                   Text="Width:"
                                   Foreground="#CCCCCC"
                                   VerticalAlignment="Center"/>
                        <NumericUpDown Grid.Column="1"
                                       x:Name="NewMapWidth"
                                       Minimum="4" Maximum="128"
                                       Value="20"
                                       FormatString="0" Increment="1"/>

                        <TextBlock Grid.Column="3"
                                   Text="Height:"
                                   Foreground="#CCCCCC"
                                   VerticalAlignment="Center"/>
                        <NumericUpDown Grid.Column="4"
                                       x:Name="NewMapHeight"
                                       Minimum="4" Maximum="128"
                                       Value="15"
                                       FormatString="0" Increment="1"/>
                    </Grid>

                    <TextBlock Text="Area = размеру карты"
                               Foreground="#888888"
                               FontSize="10"
                               FontStyle="Italic"/>

                    <TextBlock x:Name="NewMapStatus"
                               FontSize="11"
                               TextWrapping="Wrap"
                               IsVisible="False"/>

                    <StackPanel Orientation="Horizontal"
                                Spacing="8"
                                HorizontalAlignment="Right">
                        <Button x:Name="NewMapCancelBtn"
                                Content="Cancel"
                                MinWidth="90"
                                Click="OnNewMapCancelClick"/>
                        <Button x:Name="NewMapOkBtn"
                                Content="OK"
                                MinWidth="90"
                                FontWeight="Bold"
                                Background="#4CAF50"
                                Foreground="White"
                                Click="OnNewMapOkClick"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Panel>

        <!-- ═══════════════════════════════════════════════════════════ -->
        <!-- ОВЕРЛЕЙ: Delete Map                                         -->
        <!-- ═══════════════════════════════════════════════════════════ -->
        <Panel x:Name="DeleteMapOverlay"
               IsVisible="False"
               Background="#80000000">
            <Border Width="400"
                    Background="#2D2D30"
                    BorderBrush="#555555"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="20"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center">
                <StackPanel Spacing="12">
                    <TextBlock Text="Delete Map"
                               FontSize="16" FontWeight="Bold"
                               Foreground="#E74C3C"/>

                    <TextBlock x:Name="DeleteMapText"
                               Foreground="White"
                               FontSize="12"
                               TextWrapping="Wrap"/>

                    <TextBlock Text="This cannot be undone."
                               Foreground="#888888"
                               FontSize="11"
                               FontStyle="Italic"/>

                    <StackPanel Orientation="Horizontal"
                                Spacing="8"
                                HorizontalAlignment="Right">
                        <Button Content="No"
                                MinWidth="90"
                                Click="OnDeleteMapNoClick"/>
                        <Button Content="Yes"
                                MinWidth="90"
                                FontWeight="Bold"
                                Background="#E74C3C"
                                Foreground="White"
                                Click="OnDeleteMapYesClick"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Panel>

        <!-- ═══════════════════════════════════════════════════════════ -->
        <!-- ОВЕРЛЕЙ: Resize Map                                         -->
        <!-- ═══════════════════════════════════════════════════════════ -->
        <Panel x:Name="ResizeMapOverlay"
               IsVisible="False"
               Background="#80000000">
            <Border Width="420"
                    Background="#2D2D30"
                    BorderBrush="#555555"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="20"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center">
                <StackPanel Spacing="12">
                    <TextBlock Text="Resize Map"
                               FontSize="16" FontWeight="Bold"
                               Foreground="White"/>

                    <TextBlock x:Name="ResizeMapCurrent"
                               Foreground="#888888"
                               FontSize="11"/>

                    <Grid ColumnDefinitions="80,*,20,80,*">
                        <TextBlock Grid.Column="0"
                                   Text="Width:"
                                   Foreground="#CCCCCC"
                                   VerticalAlignment="Center"/>
                        <NumericUpDown Grid.Column="1"
                                       x:Name="ResizeMapWidth"
                                       Minimum="4" Maximum="128"
                                       FormatString="0" Increment="1"/>

                        <TextBlock Grid.Column="3"
                                   Text="Height:"
                                   Foreground="#CCCCCC"
                                   VerticalAlignment="Center"/>
                        <NumericUpDown Grid.Column="4"
                                       x:Name="ResizeMapHeight"
                                       Minimum="4" Maximum="128"
                                       FormatString="0" Increment="1"/>
                    </Grid>

                    <TextBlock Text="Tiles outside the new size will be lost."
                               Foreground="#888888"
                               FontSize="10"
                               FontStyle="Italic"/>

                    <TextBlock x:Name="ResizeMapStatus"
                               FontSize="11"
                               TextWrapping="Wrap"
                               IsVisible="False"/>

                    <StackPanel Orientation="Horizontal"
                                Spacing="8"
                                HorizontalAlignment="Right">
                        <Button x:Name="ResizeMapCancelBtn"
                                Content="Cancel"
                                MinWidth="90"
                                Click="OnResizeMapCancelClick"/>
                        <Button x:Name="ResizeMapOkBtn"
                                Content="OK"
                                MinWidth="90"
                                FontWeight="Bold"
                                Background="#4CAF50"
                                Foreground="White"
                                Click="OnResizeMapOkClick"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Panel>

        <!-- ═══════════════════════════════════════════════════════════ -->
        <!-- ОВЕРЛЕЙ: Rename Map                                         -->
        <!-- ═══════════════════════════════════════════════════════════ -->
        <Panel x:Name="RenameMapOverlay"
               IsVisible="False"
               Background="#80000000">
            <Border Width="420"
                    Background="#2D2D30"
                    BorderBrush="#555555"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="20"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center">
                <StackPanel Spacing="12">
                    <TextBlock Text="Rename Map"
                               FontSize="16" FontWeight="Bold"
                               Foreground="White"/>

                    <TextBlock x:Name="RenameMapCurrent"
                               Foreground="#888888"
                               FontSize="11"/>

                    <Grid ColumnDefinitions="90,*">
                        <TextBlock Grid.Column="0"
                                   Text="New name:"
                                   Foreground="#CCCCCC"
                                   VerticalAlignment="Center"/>
                        <TextBox Grid.Column="1"
                                 x:Name="RenameMapName"
                                 TextInput="OnRenameMapNameTextInput"/>
                    </Grid>

                    <TextBlock Text="Only [A-Za-z0-9_-], max 30 chars. Folder will be renamed too."
                               Foreground="#888888"
                               FontSize="10"
                               FontStyle="Italic"
                               TextWrapping="Wrap"/>

                    <TextBlock x:Name="RenameMapStatus"
                               FontSize="11"
                               TextWrapping="Wrap"
                               IsVisible="False"/>

                    <StackPanel Orientation="Horizontal"
                                Spacing="8"
                                HorizontalAlignment="Right">
                        <Button x:Name="RenameMapCancelBtn"
                                Content="Cancel"
                                MinWidth="90"
                                Click="OnRenameMapCancelClick"/>
                        <Button x:Name="RenameMapOkBtn"
                                Content="OK"
                                MinWidth="90"
                                FontWeight="Bold"
                                Background="#4CAF50"
                                Foreground="White"
                                Click="OnRenameMapOkClick"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Panel>

    </Panel>
</UserControl>