<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:models="using:RpgShinzoMaker.Core.Models.Database"
             xmlns:vm="using:RpgShinzoMaker.Desktop.ViewModels"
             x:DataType="vm:ClassesViewModel"
             x:Class="RpgShinzoMaker.Desktop.Editors.DatabaseEditor.Views.ClassesPanel">

    <UserControl.Resources>
        <ControlTheme x:Key="CustomClassItem" TargetType="ListBoxItem">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Padding" Value="4,3"/>
            <Setter Property="MinHeight" Value="22"/>
            <Setter Property="Template">
                <ControlTemplate>
                    <Border Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
                        <ContentPresenter Content="{TemplateBinding Content}" ContentTemplate="{TemplateBinding ContentTemplate}"/>
                    </Border>
                </ControlTemplate>
            </Setter>
        </ControlTheme>
    </UserControl.Resources>

    <UserControl.Styles>
        <Style Selector="TextBlock">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="#E0E0E0"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        
        <!-- ОБНОВЛЕННЫЙ СТИЛЬ TEXTBOX -->
        <Style Selector="TextBox">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Padding" Value="8,2"/>
            <Setter Property="Height" Value="26"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Background" Value="#333333"/>
            <Setter Property="BorderBrush" Value="#555555"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="CornerRadius" Value="4"/> <!-- Скругление -->
        </Style>
        
        <!-- СТИЛЬ ДЛЯ ЧИСЛОВЫХ ПОЛЕЙ -->
        <Style Selector="TextBox.NumBox">
            <Setter Property="TextAlignment" Value="Center"/>
            <Setter Property="Width" Value="50"/>
        </Style>

        <!-- ОБНОВЛЕННЫЙ СТИЛЬ COMBOBOX -->
        <Style Selector="ComboBox">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Padding" Value="8,2"/>
            <Setter Property="Height" Value="26"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Background" Value="#333333"/>
            <Setter Property="BorderBrush" Value="#555555"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="CornerRadius" Value="4"/> <!-- Скругление -->
        </Style>

        <Style Selector="Border.GroupBox">
            <Setter Property="BorderBrush" Value="#3E3E42"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="4"/>
            <Setter Property="Padding" Value="8"/>
            <Setter Property="Margin" Value="0,0,0,8"/>
            <Setter Property="Background" Value="#252526"/>
        </Style>
        <Style Selector="TextBlock.GroupHeader">
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="#007ACC"/>
            <Setter Property="Margin" Value="0,0,0,6"/>
        </Style>
    </UserControl.Styles>

    <Grid ColumnDefinitions="220, *" Background="#1E1E1E">
        
        <!-- ЛЕВАЯ КОЛОНКА (СПИСОК) -->
        <Grid Grid.Column="0" RowDefinitions="Auto, *" Background="#1E1E1E" Margin="2">
            <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="4" Margin="2">
                <Button Content="Add" Background="#4CAF50" Foreground="White" FontSize="11" Padding="8,2" Height="22" Command="{Binding AddClassCommand}"/>
                <Button Content="Del" Background="#F44336" Foreground="White" FontSize="11" Padding="8,2" Height="22" Command="{Binding DeleteClassCommand}"/>
            </StackPanel>

            <ListBox Grid.Row="1" ItemsSource="{Binding Classes}" SelectedItem="{Binding SelectedClass}" 
                     Background="Transparent" Padding="0" ItemContainerTheme="{StaticResource CustomClassItem}">
                <ListBox.Styles>
                    <Style Selector="ListBoxItem:nth-child(odd)"><Setter Property="Background" Value="#252526"/></Style>
                    <Style Selector="ListBoxItem:nth-child(even)"><Setter Property="Background" Value="#2D2D30"/></Style>
                    <Style Selector="ListBoxItem:pointerover"><Setter Property="Background" Value="#3E3E42"/></Style>
                    <Style Selector="ListBoxItem:selected"><Setter Property="Background" Value="#81C784"/></Style>
                    <Style Selector="ListBoxItem:selected TextBlock">
                        <Setter Property="Foreground" Value="Black"/>
                        <Setter Property="FontWeight" Value="Bold"/>
                    </Style>
                </ListBox.Styles>
                <ListBox.ItemTemplate>
                    <DataTemplate x:DataType="models:CharacterClass">
                        <Grid ColumnDefinitions="40, *">
                            <TextBlock Grid.Column="0" Text="{Binding Id}" Foreground="#AAAAAA"/>
                            <TextBlock Grid.Column="1" Text="{Binding Name}" Foreground="White"/>
                        </Grid>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </Grid>

        <!-- ПРАВАЯ КОЛОНКА (СВОЙСТВА) -->
        <ScrollViewer Grid.Column="1" IsVisible="{Binding SelectedClass, Converter={x:Static ObjectConverters.IsNotNull}}" Margin="5">
            <StackPanel>
                
                <!-- GENERAL SETTINGS -->
                <Border Classes="GroupBox">
                    <StackPanel>
                        <TextBlock Text="General Settings" Classes="GroupHeader"/>
                        
                        <Grid ColumnDefinitions="Auto, 120, Auto, Auto, Auto, 150" RowDefinitions="Auto, Auto" HorizontalAlignment="Left">
                            
                            <TextBlock Grid.Row="0" Grid.Column="0" Text="Name:" Margin="0,2,8,2"/>
                            <TextBox Grid.Row="0" Grid.Column="1" Text="{Binding SelectedClass.Name}" MaxLength="8" Margin="0,2,15,2"/>

                            <TextBlock Grid.Row="0" Grid.Column="2" Text="ID:" Margin="0,2,8,2"/>
                            <Border Grid.Row="0" Grid.Column="3" Background="#007ACC" CornerRadius="4" Padding="8,2" VerticalAlignment="Center" Margin="0,0,15,0">
                                <TextBlock Text="{Binding SelectedClass.Id}" Foreground="White" FontWeight="Bold" />
                            </Border>

                            <TextBlock Grid.Row="0" Grid.Column="4" Text="Full Name:" Margin="0,2,8,2"/>
                            <TextBox Grid.Row="0" Grid.Column="5" Text="{Binding SelectedClass.FullName}" Margin="0,2"/>

                            <!-- ИЗМЕНЕННЫЙ БЛОК MOVE -->
                            <TextBlock Grid.Row="1" Grid.Column="0" Text="Move:" Margin="0,2,8,2"/>
                            
                            <StackPanel Grid.Row="1" Grid.Column="1" Orientation="Horizontal" Spacing="2" Margin="0,2">
                                <TextBox Text="{Binding SelectedClass.Move, Mode=TwoWay}" Classes="NumBox" MaxLength="3" Width="50" />
                                
                                <!-- Стрелочки СНАРУЖИ поля -->
                                <Grid RowDefinitions="*, *" Width="20">
                                    <Button Grid.Row="0" Content="▲" Command="{Binding IncrementMoveCommand}" 
                                            FontSize="8" Padding="0" Height="12" Background="#444444" Foreground="White" 
                                            CornerRadius="2" VerticalContentAlignment="Center" HorizontalContentAlignment="Center"/>
                                    <Button Grid.Row="1" Content="▼" Command="{Binding DecrementMoveCommand}" 
                                            FontSize="8" Padding="0" Height="12" Background="#444444" Foreground="White" 
                                            CornerRadius="2" VerticalContentAlignment="Center" HorizontalContentAlignment="Center" Margin="0,2,0,0"/>
                                </Grid>
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- ATTRIBUTES and RESISTANCE -->
                <Grid ColumnDefinitions="*, *">
                    <Border Grid.Column="0" Classes="GroupBox" Margin="0,0,4,8">
                        <StackPanel>
                            <TextBlock Text="Attributes" Classes="GroupHeader"/>
                            <Grid ColumnDefinitions="80, *" RowDefinitions="Auto, Auto, Auto, Auto" HorizontalAlignment="Left">
                                <TextBlock Grid.Row="0" Grid.Column="0" Text="Race:" Margin="0,2"/>
                                <ComboBox Grid.Row="0" Grid.Column="1" ItemsSource="{Binding Races}" SelectedItem="{Binding SelectedClass.Race}" Width="120" Margin="0,2"/>

                                <TextBlock Grid.Row="1" Grid.Column="0" Text="Status:" Margin="0,2"/>
                                <ComboBox Grid.Row="1" Grid.Column="1" ItemsSource="{Binding Statuses}" SelectedItem="{Binding SelectedClass.Status}" Width="120" Margin="0,2"/>

                                <TextBlock Grid.Row="2" Grid.Column="0" Text="MoveType:" Margin="0,2"/>
                                <ComboBox Grid.Row="2" Grid.Column="1" ItemsSource="{Binding MoveTypes}" SelectedItem="{Binding SelectedClass.MoveType}" Width="160" Margin="0,2"/>

                                <TextBlock Grid.Row="3" Grid.Column="0" Text="InitStatus:" Margin="0,2"/>
                                <TextBox Grid.Row="3" Grid.Column="1" Text="{Binding SelectedClass.InitialStatus}" Width="120" HorizontalAlignment="Left" Margin="0,2"/>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <Border Grid.Column="1" Classes="GroupBox" Margin="4,0,0,8">
                        <StackPanel>
                            <TextBlock Text="Resistance" Classes="GroupHeader"/>
                            <Grid ColumnDefinitions="80, 100, *" RowDefinitions="Auto, Auto, Auto, Auto, Auto, Auto, Auto, Auto" HorizontalAlignment="Left">
                                
                                <TextBlock Grid.Row="0" Grid.Column="0" Text="Wind:" Margin="0,1"/>
                                <ComboBox Grid.Row="0" Grid.Column="1" ItemsSource="{Binding Resistances}" SelectedItem="{Binding SelectedClass.Resistance.Wind}" Margin="0,1"/>
                                <TextBlock Grid.Row="0" Grid.Column="2" Text="{Binding SelectedClass.Resistance.Wind}" Foreground="#81C784" FontWeight="Bold" VerticalAlignment="Center" Margin="5,1"/>
                                
                                <TextBlock Grid.Row="1" Grid.Column="0" Text="Lightning:" Margin="0,1"/>
                                <ComboBox Grid.Row="1" Grid.Column="1" ItemsSource="{Binding Resistances}" SelectedItem="{Binding SelectedClass.Resistance.Lightning}" Margin="0,1"/>
                                <TextBlock Grid.Row="1" Grid.Column="2" Text="{Binding SelectedClass.Resistance.Lightning}" Foreground="#81C784" FontWeight="Bold" VerticalAlignment="Center" Margin="5,1"/>
                                
                                <TextBlock Grid.Row="2" Grid.Column="0" Text="Ice:" Margin="0,1"/>
                                <ComboBox Grid.Row="2" Grid.Column="1" ItemsSource="{Binding Resistances}" SelectedItem="{Binding SelectedClass.Resistance.Ice}" Margin="0,1"/>
                                <TextBlock Grid.Row="2" Grid.Column="2" Text="{Binding SelectedClass.Resistance.Ice}" Foreground="#81C784" FontWeight="Bold" VerticalAlignment="Center" Margin="5,1"/>
                                
                                <TextBlock Grid.Row="3" Grid.Column="0" Text="Fire:" Margin="0,1"/>
                                <ComboBox Grid.Row="3" Grid.Column="1" ItemsSource="{Binding Resistances}" SelectedItem="{Binding SelectedClass.Resistance.Fire}" Margin="0,1"/>
                                <TextBlock Grid.Row="3" Grid.Column="2" Text="{Binding SelectedClass.Resistance.Fire}" Foreground="#81C784" FontWeight="Bold" VerticalAlignment="Center" Margin="5,1"/>
                                
                                <TextBlock Grid.Row="4" Grid.Column="0" Text="Aqua:" Margin="0,1"/>
                                <ComboBox Grid.Row="4" Grid.Column="1" ItemsSource="{Binding Resistances}" SelectedItem="{Binding SelectedClass.Resistance.Aqua}" Margin="0,1"/>
                                <TextBlock Grid.Row="4" Grid.Column="2" Text="{Binding SelectedClass.Resistance.Aqua}" Foreground="#81C784" FontWeight="Bold" VerticalAlignment="Center" Margin="5,1"/>
                                
                                <TextBlock Grid.Row="5" Grid.Column="0" Text="Earth:" Margin="0,1"/>
                                <ComboBox Grid.Row="5" Grid.Column="1" ItemsSource="{Binding Resistances}" SelectedItem="{Binding SelectedClass.Resistance.Earth}" Margin="0,1"/>
                                <TextBlock Grid.Row="5" Grid.Column="2" Text="{Binding SelectedClass.Resistance.Earth}" Foreground="#81C784" FontWeight="Bold" VerticalAlignment="Center" Margin="5,1"/>
                                
                                <TextBlock Grid.Row="6" Grid.Column="0" Text="Neutral:" Margin="0,1"/>
                                <ComboBox Grid.Row="6" Grid.Column="1" ItemsSource="{Binding Resistances}" SelectedItem="{Binding SelectedClass.Resistance.Neutral}" Margin="0,1"/>
                                <TextBlock Grid.Row="6" Grid.Column="2" Text="{Binding SelectedClass.Resistance.Neutral}" Foreground="#81C784" FontWeight="Bold" VerticalAlignment="Center" Margin="5,1"/>
                                
                                <TextBlock Grid.Row="7" Grid.Column="0" Text="Affliction:" Margin="0,1"/>
                                <ComboBox Grid.Row="7" Grid.Column="1" ItemsSource="{Binding Resistances}" SelectedItem="{Binding SelectedClass.Resistance.Affliction}" Margin="0,1"/>
                                <TextBlock Grid.Row="7" Grid.Column="2" Text="{Binding SelectedClass.Resistance.Affliction}" Foreground="#81C784" FontWeight="Bold" VerticalAlignment="Center" Margin="5,1"/>
                            </Grid>
                        </StackPanel>
                    </Border>
                </Grid>

                <!-- PROWESS -->
                <Border Classes="GroupBox">
                    <StackPanel>
                        <TextBlock Text="Prowess (через запятую)" Classes="GroupHeader"/>
                        <TextBox Text="{Binding SelectedClass.ProwessString}" Margin="0,2" Width="400" HorizontalAlignment="Left"/>
                    </StackPanel>
                </Border>

            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>