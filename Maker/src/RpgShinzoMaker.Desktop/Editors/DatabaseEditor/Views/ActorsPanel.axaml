<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:models="using:RpgShinzoMaker.Core.Models.Database"
             xmlns:vm="using:RpgShinzoMaker.Desktop.ViewModels"
             x:DataType="vm:ActorsViewModel"
             x:Class="RpgShinzoMaker.Desktop.Editors.DatabaseEditor.Views.ActorsPanel">

    <UserControl.Resources>
        <ControlTheme x:Key="CustomActorItem" TargetType="ListBoxItem">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Padding" Value="4,3"/>
            <Setter Property="MinHeight" Value="22"/>
            <Setter Property="Template">
                <ControlTemplate>
                    <Border Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
                        <ContentPresenter Content="{TemplateBinding Content}" ContentTemplate="{TemplateBinding ContentTemplate}"/>
                    </Border>
                </ControlTemplate>
            </Setter>
        </ControlTheme>
    </UserControl.Resources>

    <UserControl.Styles>
        <Style Selector="TextBlock">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="#E0E0E0"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        
        <!-- ОБЩИЕ СТИЛИ ПОЛЕЙ -->
        <Style Selector="TextBox">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Padding" Value="4,2"/>
            <Setter Property="Height" Value="24"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Background" Value="#333333"/>
            <Setter Property="BorderBrush" Value="#555555"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Foreground" Value="White"/>
        </Style>
        <Style Selector="ComboBox">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Padding" Value="4,2"/>
            <Setter Property="Height" Value="24"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Background" Value="#333333"/>
            <Setter Property="BorderBrush" Value="#555555"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Foreground" Value="White"/>
        </Style>
        
        <!-- СТИЛИ ДЛЯ МАЛЕНЬКИХ ПОЛЕЙ УРОВНЯ -->
        <Style Selector="TextBox.LevelBox">
            <Setter Property="Width" Value="36"/> <!-- Ровно под 3 цифры -->
            <Setter Property="MinWidth" Value="0"/> <!-- Убиваем минимальную ширину темы -->
            <Setter Property="Padding" Value="2,0"/> <!-- Убираем лишние отступы -->
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
        </Style>

        <Style Selector="Button.ArrowBtn">
            <Setter Property="Background" Value="#444444"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Width" Value="16"/>
            <Setter Property="Height" Value="11"/>
            <Setter Property="FontSize" Value="8"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
        <Style Selector="Button.ArrowBtn:pointerover">
            <Setter Property="Background" Value="#666666"/>
        </Style>

        <Style Selector="Border.GroupBox">
            <Setter Property="BorderBrush" Value="#3E3E42"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="3"/>
            <Setter Property="Padding" Value="6"/>
            <Setter Property="Margin" Value="0,0,0,8"/>
            <Setter Property="Background" Value="#252526"/>
        </Style>
        <Style Selector="TextBlock.GroupHeader">
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="#007ACC"/>
            <Setter Property="Margin" Value="0,0,0,6"/>
        </Style>
    </UserControl.Styles>

    <Grid ColumnDefinitions="220, *" Background="#1E1E1E">
        
        <Grid Grid.Column="0" RowDefinitions="Auto, *" Background="#1E1E1E" Margin="2">
            <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="4" Margin="2">
                <Button Content="Add" Background="#4CAF50" Foreground="White" FontSize="11" Padding="8,2" Height="22" Command="{Binding AddActorCommand}"/>
                <Button Content="Del" Background="#F44336" Foreground="White" FontSize="11" Padding="8,2" Height="22" Command="{Binding DeleteActorCommand}"/>
            </StackPanel>

            <ListBox Grid.Row="1" ItemsSource="{Binding Actors}" SelectedItem="{Binding SelectedActor}" 
                     Background="Transparent" Padding="0" SelectionMode="Single"
                     ItemContainerTheme="{StaticResource CustomActorItem}">
                <ListBox.Styles>
                    <Style Selector="ListBoxItem:nth-child(odd)">
                        <Setter Property="Background" Value="#252526"/>
                    </Style>
                    <Style Selector="ListBoxItem:nth-child(even)">
                        <Setter Property="Background" Value="#2D2D30"/>
                    </Style>
                    <Style Selector="ListBoxItem:pointerover">
                        <Setter Property="Background" Value="#3E3E42"/>
                    </Style>
                    <Style Selector="ListBoxItem:selected">
                        <Setter Property="Background" Value="#81C784"/>
                    </Style>
                    <Style Selector="ListBoxItem:selected TextBlock">
                        <Setter Property="Foreground" Value="Black"/>
                        <Setter Property="FontWeight" Value="Bold"/>
                    </Style>
                </ListBox.Styles>

                <ListBox.ItemTemplate>
                    <DataTemplate x:DataType="models:Actor">
                        <Grid ColumnDefinitions="40, *">
                            <TextBlock Grid.Column="0" Text="{Binding Id, StringFormat='{}{0:D4}'}" Foreground="#AAAAAA"/>
                            <TextBlock Grid.Column="1" Text="{Binding Name}" Foreground="White"/>
                        </Grid>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </Grid>

        <ScrollViewer Grid.Column="1" IsVisible="{Binding SelectedActor, Converter={x:Static ObjectConverters.IsNotNull}}" Margin="5">
            <Grid RowDefinitions="Auto, Auto, Auto">
                
                <Border Grid.Row="0" Classes="GroupBox">
                    <StackPanel>
                        <TextBlock Text="General Settings" Classes="GroupHeader"/>
                        <Grid ColumnDefinitions="60, 150, 60, 120" RowDefinitions="Auto, Auto" HorizontalAlignment="Left">
                            
                            <TextBlock Grid.Row="0" Grid.Column="0" Text="Name:" Margin="0,2"/>
                            <TextBox Grid.Row="0" Grid.Column="1" Text="{Binding SelectedActor.Name}" Margin="0,2,10,2"/>
                            
                            <TextBlock Grid.Row="0" Grid.Column="2" Text="Class:" Margin="0,2"/>
                            <ComboBox Grid.Row="0" Grid.Column="3" ItemsSource="{Binding AvailableClasses}" SelectedValue="{Binding SelectedActor.ClassId}" SelectedValueBinding="{Binding Id}" Margin="0,2">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate x:DataType="models:CharacterClass">
                                        <TextBlock Text="{Binding Name}"/>
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>

                            <!-- УРОВЕНЬ (ТЕПЕРЬ МАЛЕНЬКИЙ) -->
                            <TextBlock Grid.Row="1" Grid.Column="0" Text="Level:" Margin="0,2"/>
                            <StackPanel Grid.Row="1" Grid.Column="1" Orientation="Horizontal" Spacing="2" Margin="0,2,10,2" HorizontalAlignment="Left">
                                <TextBox Classes="LevelBox" Text="{Binding SelectedActor.Level, Mode=TwoWay}" MaxLength="3" />
                                <Grid RowDefinitions="*, *" Width="16">
                                    <Button Grid.Row="0" Classes="ArrowBtn" Content="▲" Command="{Binding IncrementLevelCommand}" />
                                    <Button Grid.Row="1" Classes="ArrowBtn" Content="▼" Command="{Binding DecrementLevelCommand}" Margin="0,1,0,0"/>
                                </Grid>
                            </StackPanel>

                            <TextBlock Grid.Row="1" Grid.Column="2" Text="Portrait:" Margin="0,2"/>
                            <ComboBox Grid.Row="1" Grid.Column="3" ItemsSource="{Binding AvailablePortraits}" SelectedItem="{Binding SelectedActor.Portrait}" Margin="0,2"/>
                        </Grid>
                    </StackPanel>
                </Border>

                <Border Grid.Row="1" Classes="GroupBox">
                    <StackPanel>
                        <TextBlock Text="Images" Classes="GroupHeader"/>
                        <Grid ColumnDefinitions="60, 250" HorizontalAlignment="Left">
                            <TextBlock Grid.Column="0" Text="Mapsprite:" Margin="0,2"/>
                            <ComboBox Grid.Column="1" ItemsSource="{Binding AvailableMapsprites}" SelectedItem="{Binding SelectedActor.Mapsprite}" Margin="0,2"/>
                        </Grid>
                    </StackPanel>
                </Border>

                <Border Grid.Row="2" Classes="GroupBox">
                    <StackPanel>
                        <TextBlock Text="Initial Equipment" Classes="GroupHeader"/>
                        <Grid ColumnDefinitions="80, 100, *" Margin="0,0,0,4" HorizontalAlignment="Left">
                            <TextBlock Grid.Column="0" Text="Start Level:" Margin="0,2"/>
                            
                            <!-- СТАРТОВЫЙ УРОВЕНЬ (ТЕПЕРЬ МАЛЕНЬКИЙ) -->
                            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="2" Margin="0,2,10,2" HorizontalAlignment="Left">
                                <TextBox Classes="LevelBox" Text="{Binding CurrentInventory.StartLevel, Mode=TwoWay}" MaxLength="3" />
                                <Grid RowDefinitions="*, *" Width="16">
                                    <Button Grid.Row="0" Classes="ArrowBtn" Content="▲" Command="{Binding IncrementStartLevelCommand}" />
                                    <Button Grid.Row="1" Classes="ArrowBtn" Content="▼" Command="{Binding DecrementStartLevelCommand}" Margin="0,1,0,0"/>
                                </Grid>
                            </StackPanel>
                        </Grid>
                        <Separator Background="#3E3E42" Margin="0,2,0,4"/>
                        
                        <ItemsControl ItemsSource="{Binding CurrentInventory.Items}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="models:StartItem">
                                    <Grid ColumnDefinitions="60, 200, 80" Margin="0,1" HorizontalAlignment="Left">
                                        <TextBlock Grid.Column="0" Text="Item:" Margin="0,2"/>
                                        <ComboBox Grid.Column="1" ItemsSource="{Binding $parent[UserControl].((vm:ActorsViewModel)DataContext).AvailableItems}" SelectedItem="{Binding Item}" Margin="0,2,10,2"/>

                                     <CheckBox Grid.Column="2" Content="Equipped" 
                                        IsChecked="{Binding Equipped}" 
                                        IsEnabled="{Binding Item, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" 
                                        FontSize="11" VerticalAlignment="Center"/>

                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

            </Grid>
        </ScrollViewer>
    </Grid>
</UserControl>