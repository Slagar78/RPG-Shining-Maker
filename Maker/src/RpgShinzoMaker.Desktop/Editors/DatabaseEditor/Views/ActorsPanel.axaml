<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:models="using:RpgShinzoMaker.Core.Models.Database"
             xmlns:vm="using:RpgShinzoMaker.Desktop.ViewModels"
             x:DataType="vm:ActorsViewModel"
             x:Class="RpgShinzoMaker.Desktop.Editors.DatabaseEditor.Views.ActorsPanel">

    <UserControl.Resources>
        <ControlTheme x:Key="CustomActorItem" TargetType="ListBoxItem">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Padding" Value="4,3"/>
            <Setter Property="Template">
                <ControlTemplate>
                    <Border Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
                        <ContentPresenter Content="{TemplateBinding Content}" ContentTemplate="{TemplateBinding ContentTemplate}"/>
                    </Border>
                </ControlTemplate>
            </Setter>
        </ControlTheme>
    </UserControl.Resources>

    <UserControl.Styles>
        <Style Selector="TextBlock">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="#E0E0E0"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        
        <!-- СОВРЕМЕННЫЙ СТИЛЬ TEXTBOX -->
        <Style Selector="TextBox">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Padding" Value="8,2"/>
            <Setter Property="Height" Value="26"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Background" Value="#333333"/>
            <Setter Property="BorderBrush" Value="#555555"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="CornerRadius" Value="4"/>
        </Style>
        
        <!-- СТИЛЬ ДЛЯ ЧИСЛОВЫХ ПОЛЕЙ -->
        <Style Selector="TextBox.NumBox">
            <Setter Property="TextAlignment" Value="Center"/>
            <Setter Property="Width" Value="55"/>
        </Style>

        <!-- СТИЛЬ ДЛЯ СТРЕЛОЧЕК -->
        <Style Selector="Button.ArrowBtn">
            <Setter Property="Background" Value="#444444"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Width" Value="18"/>
            <Setter Property="Height" Value="12"/>
            <Setter Property="FontSize" Value="8"/>
            <Setter Property="CornerRadius" Value="2"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
        <Style Selector="Button.ArrowBtn:pointerover">
            <Setter Property="Background" Value="#666666"/>
        </Style>

        <!-- СОВРЕМЕННЫЙ СТИЛЬ COMBOBOX -->
        <Style Selector="ComboBox">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Padding" Value="8,2"/>
            <Setter Property="Height" Value="26"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Background" Value="#333333"/>
            <Setter Property="BorderBrush" Value="#555555"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="CornerRadius" Value="4"/>
        </Style>
        
        <Style Selector="Border.GroupBox">
            <Setter Property="BorderBrush" Value="#3E3E42"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="4"/>
            <Setter Property="Padding" Value="8"/>
            <Setter Property="Margin" Value="0,0,0,8"/>
            <Setter Property="Background" Value="#252526"/>
        </Style>
        <Style Selector="TextBlock.GroupHeader">
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="#007ACC"/>
            <Setter Property="Margin" Value="0,0,0,6"/>
        </Style>
    </UserControl.Styles>

    <Grid ColumnDefinitions="220, *" Background="#1E1E1E">
        
        <!-- ЛЕВАЯ КОЛОНКА (СПИСОК) -->
        <Grid Grid.Column="0" RowDefinitions="Auto, *" Background="#1E1E1E" Margin="2">
            <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="4" Margin="2">
                <Button Content="Add" Background="#4CAF50" Foreground="White" FontSize="11" Padding="8,2" Height="22" Command="{Binding AddActorCommand}"/>
                <Button Content="Del" Background="#F44336" Foreground="White" FontSize="11" Padding="8,2" Height="22" Command="{Binding DeleteActorCommand}"/>
            </StackPanel>
            <ListBox Grid.Row="1" ItemsSource="{Binding Actors}" SelectedItem="{Binding SelectedActor}" Background="Transparent" Padding="0" ItemContainerTheme="{StaticResource CustomActorItem}">
                <ListBox.Styles>
                    <Style Selector="ListBoxItem:nth-child(odd)"><Setter Property="Background" Value="#252526"/></Style>
                    <Style Selector="ListBoxItem:nth-child(even)"><Setter Property="Background" Value="#2D2D30"/></Style>
                    <Style Selector="ListBoxItem:pointerover"><Setter Property="Background" Value="#3E3E42"/></Style>
                    <Style Selector="ListBoxItem:selected"><Setter Property="Background" Value="#81C784"/></Style>
                    <Style Selector="ListBoxItem:selected TextBlock"><Setter Property="Foreground" Value="Black"/><Setter Property="FontWeight" Value="Bold"/></Style>
                </ListBox.Styles>
                <ListBox.ItemTemplate>
                    <DataTemplate x:DataType="models:Actor">
                        <Grid ColumnDefinitions="40, *">
                            <TextBlock Grid.Column="0" Text="{Binding Id, StringFormat='{}{0:D4}'}" Foreground="#AAAAAA"/>
                            <TextBlock Grid.Column="1" Text="{Binding Name}" Foreground="White"/>
                        </Grid>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </Grid>

        <!-- ПРАВАЯ КОЛОНКА (СВОЙСТВА) -->
        <ScrollViewer Grid.Column="1" IsVisible="{Binding SelectedActor, Converter={x:Static ObjectConverters.IsNotNull}}" Margin="5">
            <Grid ColumnDefinitions="*, *" RowDefinitions="Auto">
                
                <!-- ЛЕВАЯ ЧАСТЬ (General, Block Settings, Equipment) -->
                <StackPanel Grid.Column="0" Margin="0,0,5,0">
                    
                    <!-- GENERAL SETTINGS -->
                    <Border Classes="GroupBox">
                        <StackPanel>
                            <TextBlock Text="General Settings" Classes="GroupHeader"/>
                            
                            <StackPanel Orientation="Horizontal" Spacing="10" Margin="0,2">
                                <TextBlock Text="Name:" VerticalAlignment="Center"/>
                                <TextBox Text="{Binding SelectedActor.Name}" Width="120"/>
                                <TextBlock Text="ID:" VerticalAlignment="Center"/>
                                <Border Background="#007ACC" CornerRadius="4" Padding="8,2" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding SelectedActor.Id}" Foreground="White" FontWeight="Bold"/>
                                </Border>
                            </StackPanel>

                            <!-- Exp -->
                            <StackPanel Orientation="Horizontal" Spacing="10" Margin="0,6,0,0">
                                <TextBlock Text="Exp:" Width="40" VerticalAlignment="Center"/>
                                <StackPanel Orientation="Horizontal" Spacing="2">
                                    <TextBox Classes="NumBox" Text="{Binding SelectedActor.Exp}" MaxLength="5"/>
                                    <Grid RowDefinitions="*, *" Width="18">
                                        <Button Grid.Row="0" Content="▲" Classes="ArrowBtn" Command="{Binding IncrementExpCommand}"/>
                                        <Button Grid.Row="1" Content="▼" Classes="ArrowBtn" Command="{Binding DecrementExpCommand}" Margin="0,2,0,0"/>
                                    </Grid>
                                </StackPanel>
                            </StackPanel>

                            <!-- Kills & Defeats -->
                            <StackPanel Orientation="Horizontal" Spacing="10" Margin="0,6,0,0">
                                <TextBlock Text="Kills:" Width="40" VerticalAlignment="Center"/>
                                <StackPanel Orientation="Horizontal" Spacing="2">
                                    <TextBox Classes="NumBox" Text="{Binding SelectedActor.Kills}" MaxLength="5"/>
                                    <Grid RowDefinitions="*, *" Width="18">
                                        <Button Grid.Row="0" Content="▲" Classes="ArrowBtn" Command="{Binding IncrementKillsCommand}"/>
                                        <Button Grid.Row="1" Content="▼" Classes="ArrowBtn" Command="{Binding DecrementKillsCommand}" Margin="0,2,0,0"/>
                                    </Grid>
                                </StackPanel>

                                <TextBlock Text="Defeats:" VerticalAlignment="Center" Margin="10,0,0,0"/>
                                <StackPanel Orientation="Horizontal" Spacing="2">
                                    <TextBox Classes="NumBox" Text="{Binding SelectedActor.Defeats}" MaxLength="5"/>
                                    <Grid RowDefinitions="*, *" Width="18">
                                        <Button Grid.Row="0" Content="▲" Classes="ArrowBtn" Command="{Binding IncrementDefeatsCommand}"/>
                                        <Button Grid.Row="1" Content="▼" Classes="ArrowBtn" Command="{Binding DecrementDefeatsCommand}" Margin="0,2,0,0"/>
                                    </Grid>
                                </StackPanel>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- BLOCK SETTINGS -->
                    <Border Classes="GroupBox" IsVisible="{Binding SelectedBlock, Converter={x:Static ObjectConverters.IsNotNull}}">
                        <StackPanel>
                            <TextBlock Text="Block Settings" Classes="GroupHeader"/>
                            <Grid ColumnDefinitions="85, *, 60, *" RowDefinitions="Auto, Auto, Auto" HorizontalAlignment="Stretch">
                                <TextBlock Grid.Row="0" Grid.Column="0" Text="Class:" Margin="0,2"/>
                                <ComboBox Grid.Row="0" Grid.Column="1" ItemsSource="{Binding AvailableClasses}" SelectedValue="{Binding SelectedBlock.ForClass}" SelectedValueBinding="{Binding Id}" Margin="0,2,10,2">
                                    <ComboBox.ItemTemplate>
                                        <DataTemplate x:DataType="models:CharacterClass"><TextBlock Text="{Binding Name}"/></DataTemplate>
                                    </ComboBox.ItemTemplate>
                                </ComboBox>

                                <TextBlock Grid.Row="0" Grid.Column="2" Text="Portrait:" Margin="0,2"/>
                                <ComboBox Grid.Row="0" Grid.Column="3" ItemsSource="{Binding AvailablePortraits}" SelectedItem="{Binding SelectedBlock.Portrait}" Margin="0,2"/>
                                
                                <TextBlock Grid.Row="1" Grid.Column="0" Text="Mapsprite:" Margin="0,2"/>
                                <ComboBox Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="3" ItemsSource="{Binding AvailableMapsprites}" SelectedItem="{Binding SelectedBlock.Mapsprite}" Margin="0,2"/>
                                
                                <TextBlock Grid.Row="2" Grid.Column="0" Text="Battle Sprite:" Margin="0,2"/>
                                <TextBox Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="3" Text="{Binding SelectedBlock.BattleSpritePath}" Margin="0,2"/>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- INITIAL EQUIPMENT -->
                    <Border Classes="GroupBox">
                        <StackPanel>
                            <TextBlock Text="Initial Equipment" Classes="GroupHeader"/>
                            <StackPanel Orientation="Horizontal" Spacing="10" Margin="0,0,0,6">
                                <TextBlock Text="Start Level:" VerticalAlignment="Center"/>
                                <StackPanel Orientation="Horizontal" Spacing="2">
                                    <TextBox Classes="NumBox" Text="{Binding CurrentInventory.StartLevel}" MaxLength="3"/>
                                    <Grid RowDefinitions="*, *" Width="18">
                                        <Button Grid.Row="0" Content="▲" Classes="ArrowBtn" Command="{Binding IncrementStartLevelCommand}"/>
                                        <Button Grid.Row="1" Content="▼" Classes="ArrowBtn" Command="{Binding DecrementStartLevelCommand}" Margin="0,2,0,0"/>
                                    </Grid>
                                </StackPanel>
                            </StackPanel>
                            <Separator Background="#3E3E42" Margin="0,2,0,6"/>
                            
                            <!-- Сетка 2x2 -->
                            <ItemsControl ItemsSource="{Binding CurrentInventory.Items}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <UniformGrid Columns="2" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="models:StartItem">
                                        <Grid ColumnDefinitions="40, *, 60" Margin="0,0,10,5" HorizontalAlignment="Stretch">
                                            <TextBlock Grid.Column="0" Text="Item:" Margin="0,2"/>
                                            <ComboBox Grid.Column="1" ItemsSource="{Binding $parent[UserControl].((vm:ActorsViewModel)DataContext).AvailableItems}" SelectedItem="{Binding Item}" Margin="0,2,5,2" HorizontalAlignment="Stretch"/>
                                            <CheckBox Grid.Column="2" Content="Eqp" IsChecked="{Binding Equipped}" IsEnabled="{Binding Item, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" FontSize="11" VerticalAlignment="Center"/>
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- ПРАВАЯ ЧАСТЬ (Block Selection, Stats, Spell List) -->
                <StackPanel Grid.Column="1" Margin="5,0,0,0">
                    
                    <!-- CLASS BLOCK SELECTION -->
                    <Border Classes="GroupBox">
                        <StackPanel>
                            <TextBlock Text="Class Block Selection" Classes="GroupHeader"/>
                            <Grid ColumnDefinitions="50, *" RowDefinitions="Auto, Auto" HorizontalAlignment="Stretch">
                                <TextBlock Grid.Row="0" Grid.Column="0" Text="Block:" Margin="0,2"/>
                                <ComboBox Grid.Row="0" Grid.Column="1" ItemsSource="{Binding BlocksForSelectedActor}" SelectedItem="{Binding SelectedBlock}" Margin="0,2,0,5" HorizontalAlignment="Stretch">
                                    <ComboBox.ItemTemplate>
                                        <DataTemplate><TextBlock Text="{Binding DisplayName}"/></DataTemplate>
                                    </ComboBox.ItemTemplate>
                                </ComboBox>
                                <StackPanel Grid.Row="1" Grid.Column="1" Orientation="Horizontal" Spacing="5">
                                    <Button Content="+ Promo" Command="{Binding AddPromotionCommand}" Background="#4CAF50" Foreground="White" FontSize="11" Padding="6,2"/>
                                    <Button Content="- Promo" Command="{Binding DeletePromotionCommand}" Background="#F44336" Foreground="White" FontSize="11" Padding="6,2"/>
                                </StackPanel>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- STATS AND GROWTH -->
                    <Border Classes="GroupBox" IsVisible="{Binding SelectedBlock, Converter={x:Static ObjectConverters.IsNotNull}}">
                        <StackPanel>
                            <TextBlock Text="Stats and Growth" Classes="GroupHeader"/>
                            <Grid ColumnDefinitions="50, Auto, 15, Auto, 15, 100" RowDefinitions="Auto, Auto, Auto, Auto, Auto, Auto" HorizontalAlignment="Left">
                                <TextBlock Grid.Row="0" Grid.Column="1" Text="Start:" Foreground="Gray" Margin="0,6"/>
                                <TextBlock Grid.Row="0" Grid.Column="3" Text="Proj:" Foreground="Gray" Margin="0,6"/>
                                <TextBlock Grid.Row="0" Grid.Column="5" Text="Curve:" Foreground="Gray" Margin="0,6"/>

                                <!-- HP -->
                                <TextBlock Grid.Row="1" Grid.Column="0" Text="HP:" Margin="0,2"/>
                                <StackPanel Grid.Row="1" Grid.Column="1" Orientation="Horizontal" Spacing="2">
                                    <TextBox Classes="NumBox" Text="{Binding SelectedBlock.HpGrowth.Start}" MaxLength="4" Width="45"/>
                                    <Grid RowDefinitions="*, *" Width="16"><Button Grid.Row="0" Content="▲" Classes="ArrowBtn" Command="{Binding IncHpStartCommand}"/><Button Grid.Row="1" Content="▼" Classes="ArrowBtn" Command="{Binding DecHpStartCommand}" Margin="0,2,0,0"/></Grid>
                                </StackPanel>
                                <StackPanel Grid.Row="1" Grid.Column="3" Orientation="Horizontal" Spacing="2">
                                    <TextBox Classes="NumBox" Text="{Binding SelectedBlock.HpGrowth.Projected}" MaxLength="4" Width="45"/>
                                    <Grid RowDefinitions="*, *" Width="16"><Button Grid.Row="0" Content="▲" Classes="ArrowBtn" Command="{Binding IncHpProjCommand}"/><Button Grid.Row="1" Content="▼" Classes="ArrowBtn" Command="{Binding DecHpProjCommand}" Margin="0,2,0,0"/></Grid>
                                </StackPanel>
                                <ComboBox Grid.Row="1" Grid.Column="5" ItemsSource="{Binding Curves}" SelectedItem="{Binding SelectedBlock.HpGrowth.Curve}" Margin="0,2"/>

                                <!-- MP -->
                                <TextBlock Grid.Row="2" Grid.Column="0" Text="MP:" Margin="0,2"/>
                                <StackPanel Grid.Row="2" Grid.Column="1" Orientation="Horizontal" Spacing="2">
                                    <TextBox Classes="NumBox" Text="{Binding SelectedBlock.MpGrowth.Start}" MaxLength="4" Width="45"/>
                                    <Grid RowDefinitions="*, *" Width="16"><Button Grid.Row="0" Content="▲" Classes="ArrowBtn" Command="{Binding IncMpStartCommand}"/><Button Grid.Row="1" Content="▼" Classes="ArrowBtn" Command="{Binding DecMpStartCommand}" Margin="0,2,0,0"/></Grid>
                                </StackPanel>
                                <StackPanel Grid.Row="2" Grid.Column="3" Orientation="Horizontal" Spacing="2">
                                    <TextBox Classes="NumBox" Text="{Binding SelectedBlock.MpGrowth.Projected}" MaxLength="4" Width="45"/>
                                    <Grid RowDefinitions="*, *" Width="16"><Button Grid.Row="0" Content="▲" Classes="ArrowBtn" Command="{Binding IncMpProjCommand}"/><Button Grid.Row="1" Content="▼" Classes="ArrowBtn" Command="{Binding DecMpProjCommand}" Margin="0,2,0,0"/></Grid>
                                </StackPanel>
                                <ComboBox Grid.Row="2" Grid.Column="5" ItemsSource="{Binding Curves}" SelectedItem="{Binding SelectedBlock.MpGrowth.Curve}" Margin="0,2"/>

                                <!-- ATK -->
                                <TextBlock Grid.Row="3" Grid.Column="0" Text="Attack:" Margin="0,2"/>
                                <StackPanel Grid.Row="3" Grid.Column="1" Orientation="Horizontal" Spacing="2">
                                    <TextBox Classes="NumBox" Text="{Binding SelectedBlock.AttackGrowth.Start}" MaxLength="4" Width="45"/>
                                    <Grid RowDefinitions="*, *" Width="16"><Button Grid.Row="0" Content="▲" Classes="ArrowBtn" Command="{Binding IncAtkStartCommand}"/><Button Grid.Row="1" Content="▼" Classes="ArrowBtn" Command="{Binding DecAtkStartCommand}" Margin="0,2,0,0"/></Grid>
                                </StackPanel>
                                <StackPanel Grid.Row="3" Grid.Column="3" Orientation="Horizontal" Spacing="2">
                                    <TextBox Classes="NumBox" Text="{Binding SelectedBlock.AttackGrowth.Projected}" MaxLength="4" Width="45"/>
                                    <Grid RowDefinitions="*, *" Width="16"><Button Grid.Row="0" Content="▲" Classes="ArrowBtn" Command="{Binding IncAtkProjCommand}"/><Button Grid.Row="1" Content="▼" Classes="ArrowBtn" Command="{Binding DecAtkProjCommand}" Margin="0,2,0,0"/></Grid>
                                </StackPanel>
                                <ComboBox Grid.Row="3" Grid.Column="5" ItemsSource="{Binding Curves}" SelectedItem="{Binding SelectedBlock.AttackGrowth.Curve}" Margin="0,2"/>

                                <!-- DEF -->
                                <TextBlock Grid.Row="4" Grid.Column="0" Text="Defense:" Margin="0,2"/>
                                <StackPanel Grid.Row="4" Grid.Column="1" Orientation="Horizontal" Spacing="2">
                                    <TextBox Classes="NumBox" Text="{Binding SelectedBlock.DefenseGrowth.Start}" MaxLength="4" Width="45"/>
                                    <Grid RowDefinitions="*, *" Width="16"><Button Grid.Row="0" Content="▲" Classes="ArrowBtn" Command="{Binding IncDefStartCommand}"/><Button Grid.Row="1" Content="▼" Classes="ArrowBtn" Command="{Binding DecDefStartCommand}" Margin="0,2,0,0"/></Grid>
                                </StackPanel>
                                <StackPanel Grid.Row="4" Grid.Column="3" Orientation="Horizontal" Spacing="2">
                                    <TextBox Classes="NumBox" Text="{Binding SelectedBlock.DefenseGrowth.Projected}" MaxLength="4" Width="45"/>
                                    <Grid RowDefinitions="*, *" Width="16"><Button Grid.Row="0" Content="▲" Classes="ArrowBtn" Command="{Binding IncDefProjCommand}"/><Button Grid.Row="1" Content="▼" Classes="ArrowBtn" Command="{Binding DecDefProjCommand}" Margin="0,2,0,0"/></Grid>
                                </StackPanel>
                                <ComboBox Grid.Row="4" Grid.Column="5" ItemsSource="{Binding Curves}" SelectedItem="{Binding SelectedBlock.DefenseGrowth.Curve}" Margin="0,2"/>

                                <!-- AGI -->
                                <TextBlock Grid.Row="5" Grid.Column="0" Text="Agility:" Margin="0,2"/>
                                <StackPanel Grid.Row="5" Grid.Column="1" Orientation="Horizontal" Spacing="2">
                                    <TextBox Classes="NumBox" Text="{Binding SelectedBlock.AgilityGrowth.Start}" MaxLength="4" Width="45"/>
                                    <Grid RowDefinitions="*, *" Width="16"><Button Grid.Row="0" Content="▲" Classes="ArrowBtn" Command="{Binding IncAgiStartCommand}"/><Button Grid.Row="1" Content="▼" Classes="ArrowBtn" Command="{Binding DecAgiStartCommand}" Margin="0,2,0,0"/></Grid>
                                </StackPanel>
                                <StackPanel Grid.Row="5" Grid.Column="3" Orientation="Horizontal" Spacing="2">
                                    <TextBox Classes="NumBox" Text="{Binding SelectedBlock.AgilityGrowth.Projected}" MaxLength="4" Width="45"/>
                                    <Grid RowDefinitions="*, *" Width="16"><Button Grid.Row="0" Content="▲" Classes="ArrowBtn" Command="{Binding IncAgiProjCommand}"/><Button Grid.Row="1" Content="▼" Classes="ArrowBtn" Command="{Binding DecAgiProjCommand}" Margin="0,2,0,0"/></Grid>
                                </StackPanel>
                                <ComboBox Grid.Row="5" Grid.Column="5" ItemsSource="{Binding Curves}" SelectedItem="{Binding SelectedBlock.AgilityGrowth.Curve}" Margin="0,2"/>
                            </Grid>
                            <CheckBox Content="Use First Spell List" IsChecked="{Binding SelectedBlock.UseFirstSpellList}" Margin="0,8,0,0" FontSize="11" />
                        </StackPanel>
                    </Border>

                    <!-- SPELL LIST -->
                    <Border Classes="GroupBox" IsVisible="{Binding SelectedBlock, Converter={x:Static ObjectConverters.IsNotNull}}">
                        <StackPanel>
                            <TextBlock Text="Spell List" Classes="GroupHeader"/>
                            <StackPanel Orientation="Horizontal" Spacing="5" Margin="0,0,0,5">
                                <Button Content="+" Command="{Binding AddSpellCommand}" Width="24" Height="24" Background="#4CAF50" Foreground="White" FontWeight="Bold"/>
                            </StackPanel>
                            <ItemsControl ItemsSource="{Binding SelectedBlock.SpellList}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="models:ClassSpell">
                                        <Grid ColumnDefinitions="Auto, Auto, *, Auto, Auto, Auto" Margin="0,2" HorizontalAlignment="Left">
                                            
                                            <TextBlock Grid.Column="0" Text="Lvl:" VerticalAlignment="Center" Margin="0,0,5,0"/>
                                            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="2" Margin="0,0,10,0">
                                                <TextBox Classes="NumBox" Text="{Binding Level}" MaxLength="2" Width="40"/>
                                                <Grid RowDefinitions="*, *" Width="16"><Button Grid.Row="0" Content="▲" Classes="ArrowBtn" Command="{Binding $parent[UserControl].((vm:ActorsViewModel)DataContext).IncSpellLevelCommand}" CommandParameter="{Binding}"/><Button Grid.Row="1" Content="▼" Classes="ArrowBtn" Command="{Binding $parent[UserControl].((vm:ActorsViewModel)DataContext).DecSpellLevelCommand}" CommandParameter="{Binding}" Margin="0,2,0,0"/></Grid>
                                            </StackPanel>
                                            
                                            <ComboBox Grid.Column="2" ItemsSource="{Binding $parent[UserControl].((vm:ActorsViewModel)DataContext).AvailableSpells}" SelectedValue="{Binding SpellId}" SelectedValueBinding="{Binding Id}" Margin="0,0,10,0">
                                                <ComboBox.ItemTemplate>
                                                    <DataTemplate x:DataType="models:Spell"><TextBlock Text="{Binding Name}"/></DataTemplate>
                                                </ComboBox.ItemTemplate>
                                            </ComboBox>
                                            
                                            <TextBlock Grid.Column="3" Text="Lv:" VerticalAlignment="Center" Margin="0,0,5,0"/>
                                            <StackPanel Grid.Column="4" Orientation="Horizontal" Spacing="2" Margin="0,0,10,0">
                                                <TextBox Classes="NumBox" Text="{Binding SpellLevel}" MaxLength="2" Width="40"/>
                                                <Grid RowDefinitions="*, *" Width="16"><Button Grid.Row="0" Content="▲" Classes="ArrowBtn" Command="{Binding $parent[UserControl].((vm:ActorsViewModel)DataContext).IncSpellLevelCmdCommand}" CommandParameter="{Binding}"/><Button Grid.Row="1" Content="▼" Classes="ArrowBtn" Command="{Binding $parent[UserControl].((vm:ActorsViewModel)DataContext).DecSpellLevelCmdCommand}" CommandParameter="{Binding}" Margin="0,2,0,0"/></Grid>
                                            </StackPanel>
                                            
                                            <Button Grid.Column="5" Content="X" Command="{Binding $parent[UserControl].((vm:ActorsViewModel)DataContext).RemoveSpellCommand}" CommandParameter="{Binding}" Background="#F44336" Foreground="White" Width="24" Height="24" Padding="0" VerticalAlignment="Center"/>
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>
        </ScrollViewer>
    </Grid>
</UserControl>