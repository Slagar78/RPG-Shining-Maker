<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="using:RpgShinzoMaker.Desktop.Editors.DatabaseEditor.Views"
             xmlns:vm="using:RpgShinzoMaker.Desktop.ViewModels"
             x:DataType="vm:MainViewModel"
             x:Class="RpgShinzoMaker.Desktop.Editors.DatabaseEditor.DatabaseEditorView">
    
    <UserControl.Styles>
        <!-- Стиль для вертикальных вкладок (как в RPG Maker) -->
        <Style Selector="TabItem">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Foreground" Value="#AAAAAA"/>
            <Setter Property="Padding" Value="15,10"/>
            <Setter Property="Margin" Value="0,2,0,0"/>
            <Setter Property="Background" Value="#2D2D30"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="CornerRadius" Value="0"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
        </Style>
        <!-- При наведении -->
        <Style Selector="TabItem:pointerover">
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="Background" Value="#3E3E42"/>
        </Style>
        <!-- Активная вкладка (синяя полоска) -->
        <Style Selector="TabItem:selected">
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="Background" Value="#005A9E"/>
            <Setter Property="FontWeight" Value="Bold"/>
        </Style>
    </UserControl.Styles>

    <Grid RowDefinitions="Auto,*">
        <!-- Верхняя панель -->
        <Border Grid.Row="0" Background="#2D2D30" Padding="10">
            <StackPanel Orientation="Horizontal" Spacing="10">
                <Button Content="SAVE DATABASE" 
                        Background="#4CAF50" 
                        Foreground="White" 
                        FontWeight="Bold"
                        Command="{Binding SaveCommand}"/>
            </StackPanel>
        </Border>

        <!-- Главный TabControl -->
        <TabControl Grid.Row="1" TabStripPlacement="Left" Margin="0" Background="#1E1E1E">
            
            <TabItem Header="Heroes">
                <views:ActorsPanel DataContext="{Binding ActorsVM}" />
            </TabItem>

            <TabItem Header="Enemies">
                <TextBlock Text="Enemies Panel will be here" Foreground="Gray" VerticalAlignment="Center" HorizontalAlignment="Center"/>
            </TabItem>

            <TabItem Header="Classes">
                <TextBlock Text="Classes Panel will be here" Foreground="Gray" VerticalAlignment="Center" HorizontalAlignment="Center"/>
            </TabItem>

            <TabItem Header="Items">
                <views:ItemsPanel DataContext="{Binding ItemsVM}" />
            </TabItem>

            <TabItem Header="Spells">
                <TextBlock Text="Spells Panel will be here" Foreground="Gray" VerticalAlignment="Center" HorizontalAlignment="Center"/>
            </TabItem>

            <TabItem Header="System">
                <TextBlock Text="System Panel will be here" Foreground="Gray" VerticalAlignment="Center" HorizontalAlignment="Center"/>
            </TabItem>

        </TabControl>
    </Grid>
</UserControl>