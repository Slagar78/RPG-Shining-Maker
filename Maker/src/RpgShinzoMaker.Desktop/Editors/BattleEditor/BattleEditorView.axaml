<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="using:RpgShinzoMaker.Desktop.Views"
             xmlns:battleEditor="using:RpgShinzoMaker.Desktop.Editors.BattleEditor"
             xmlns:core="using:RpgShinzoMaker.Core.Models"
             x:Class="RpgShinzoMaker.Desktop.Editors.BattleEditor.BattleEditorView">

    <UserControl.Styles>
        <Style Selector="ComboBox.ModernComboBox">
            <Setter Property="Background" Value="#2D2D30"/>
            <Setter Property="BorderBrush" Value="#3E3E42"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="4"/>
            <Setter Property="Padding" Value="8,0"/>
            <Setter Property="Foreground" Value="#E0E0E0"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Height" Value="28"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
        <Style Selector="ComboBox.ModernComboBox:pointerover /template/ Border#Background">
            <Setter Property="BorderBrush" Value="#007ACC"/>
            <Setter Property="Background" Value="#3E3E42"/>
        </Style>
    </UserControl.Styles>

    <Grid ColumnDefinitions="250,4,*,4,200">

        <!-- ═══════════════════════════════════════════════════════ -->
        <!-- КОЛОНКА 0: ALLIES + ENEMIES                             -->
        <!-- ═══════════════════════════════════════════════════════ -->
        <Border Grid.Column="0" Background="#252526" Padding="8">
            <Border Background="#1E1E1E"
                    BorderBrush="#3E3E42"
                    BorderThickness="1"
                    CornerRadius="4">
                <Grid Margin="8" RowDefinitions="Auto,Auto,Auto,Auto,Auto,*,Auto">

                    <!-- ALLIES -->
                    <TextBlock Grid.Row="0"
                               Text="ALLIES"
                               Foreground="White"
                               FontWeight="Bold"
                               Margin="0,0,0,6"/>

                    <ItemsControl Grid.Row="1"
                                  x:Name="AlliesPanel"
                                  Margin="0,0,0,6">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <UniformGrid Columns="4"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="battleEditor:BattleUnit">
                                <Border Width="50" Height="50"
                                        Margin="1"
                                        Background="#2A2A2A"
                                        BorderBrush="#3E3E42"
                                        BorderThickness="1">
                                    <Image Source="{Binding Image}"
                                           Stretch="Uniform"
                                           RenderOptions.BitmapInterpolationMode="None"/>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <StackPanel Grid.Row="2" Orientation="Horizontal" Spacing="4" Margin="0,0,0,10">
                        <Button Content="+ Add"
                                MinWidth="70"
                                HorizontalAlignment="Left"
                                Click="OnAddAllyClick"/>
                        <Button Content="− Del"
                                MinWidth="70"
                                HorizontalAlignment="Left"
                                Click="OnDeleteAllyClick"/>
                    </StackPanel>

                    <!-- ENEMIES -->
                    <TextBlock Grid.Row="3"
                               Text="ENEMIES"
                               Foreground="White"
                               FontWeight="Bold"
                               Margin="0,0,0,6"/>

                    <ItemsControl Grid.Row="4"
                                  x:Name="EnemiesPanel">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <UniformGrid Columns="4"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="battleEditor:BattleUnit">
                                <Border Width="50" Height="50"
                                        Margin="1"
                                        Background="#2A2A2A"
                                        BorderBrush="#3E3E42"
                                        BorderThickness="1">
                                    <Image Source="{Binding Image}"
                                           Stretch="Uniform"
                                           RenderOptions.BitmapInterpolationMode="None"/>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <StackPanel Grid.Row="6" Orientation="Horizontal" Spacing="4" Margin="0,6,0,0">
                        <Button Content="+ Add"
                                MinWidth="70"
                                HorizontalAlignment="Left"
                                Click="OnAddEnemyClick"/>
                        <Button Content="− Del"
                                MinWidth="70"
                                HorizontalAlignment="Left"
                                Click="OnDeleteEnemyClick"/>
                    </StackPanel>
                </Grid>
            </Border>
        </Border>

        <!-- Разделитель -->
        <Border Grid.Column="1" Background="#3E3E42" Width="4"/>

        <!-- ═══════════════════════════════════════════════════════ -->
        <!-- КОЛОНКА 2: TOOLBAR + MAPCANVAS + OVERLAY + BOTTOM       -->
        <!-- ═══════════════════════════════════════════════════════ -->
        <Grid Grid.Column="2" RowDefinitions="Auto,*,Auto">

            <!-- Toolbar -->
            <Border Grid.Row="0"
                    Background="#1E1E1E"
                    BorderBrush="#3E3E42"
                    BorderThickness="0,0,0,1"
                    Padding="10,6">
                <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                    <ToggleButton x:Name="ModeMapBtn"
                                  Content="Map"
                                  IsChecked="True"
                                  Click="OnModeMapClick"/>
                    <ToggleButton x:Name="ModeBattleBtn"
                                  Content="Battle"
                                  Click="OnModeBattleClick"/>
                    <ToggleButton x:Name="ModeTerrainBtn"
                                  Content="Terrain"
                                  Click="OnModeTerrainClick"/>

                    <Border Width="1" Background="#3E3E42" Margin="4,0"/>

                    <ToggleButton x:Name="ZoneBtn"
                                  Content="Zone"
                                  Click="OnZoneToggleClick"/>

                    <!-- ★ КИСТИ TERRAIN (B / F / W) ★ -->
                    <StackPanel x:Name="TerrainBrushesPanel" 
                                Orientation="Horizontal" 
                                Spacing="4" 
                                IsVisible="False"
                                VerticalAlignment="Center">
                        <Button Content="B" Tag="-1" Click="OnTerrainBrushClick" 
                                Background="#E74C3C" Foreground="White" Width="28" Height="24" 
                                Padding="0" FontWeight="Bold" ToolTip.Tip="Blocked (-1)"/>
                        <Button Content="F" Tag="0" Click="OnTerrainBrushClick" 
                                Background="#F1C40F" Foreground="Black" Width="28" Height="24" 
                                Padding="0" FontWeight="Bold" ToolTip.Tip="Fly only (0)"/>
                        <Button Content="W" Tag="1" Click="OnTerrainBrushClick" 
                                Background="#4CAF50" Foreground="White" Width="28" Height="24" 
                                Padding="0" FontWeight="Bold" ToolTip.Tip="Walkable (1)"/>
                    </StackPanel>

                    <Border Width="1" Background="#3E3E42" Margin="4,0"/>

                    <Button Content="Save"
                            FontWeight="Bold"
                            Background="#C88A50"
                            Foreground="White"
                            Click="OnSaveClick"/>

                    <Border Width="1" Background="#3E3E42" Margin="4,0"/>

                    <TextBlock Text="Zoom"
                               Foreground="#AAAAAA"
                               VerticalAlignment="Center"/>
                    <ComboBox x:Name="ZoomSelector"
                              Classes="ModernComboBox"
                              Width="90"
                              SelectedIndex="2"
                              SelectionChanged="OnZoomChanged">
                        <ComboBoxItem Content="1/4x"/>
                        <ComboBoxItem Content="1/2x"/>
                        <ComboBoxItem Content="1x"/>
                        <ComboBoxItem Content="2x"/>
                        <ComboBoxItem Content="4x"/>
                    </ComboBox>

                    <Border Width="1" Background="#3E3E42" Margin="4,0"/>

                    <TextBlock x:Name="ToolbarInfo"
                               Foreground="#FFD700"
                               VerticalAlignment="Center"
                               Text="—"/>
                </StackPanel>
            </Border>

            <!-- Карта + оверлей -->
            <Grid Grid.Row="1" ClipToBounds="True" Background="#1E1E1E">
                <views:MapCanvas x:Name="MapCanvasControl"/>
                <Canvas x:Name="OverlayCanvas" IsHitTestVisible="False"/>
            </Grid>

            <!-- Bottom bar -->
            <Border Grid.Row="2"
                    Background="#1E1E1E"
                    BorderBrush="#3E3E42"
                    BorderThickness="0,1,0,0"
                    Padding="10,4">
                <StackPanel Orientation="Horizontal" Spacing="16">
                    <TextBlock x:Name="BottomModeText"
                               Foreground="#FFD700"
                               Text="GLOBAL MAP"/>
                    <TextBlock x:Name="BottomZoneText"
                               Foreground="#AAAAAA"
                               Text="Zone: —"/>
                    <TextBlock x:Name="BottomTerrainText"
                               Foreground="#AAAAAA"
                               Text="Terrain: Walkable"/>
                </StackPanel>
            </Border>
        </Grid>

        <!-- Разделитель -->
        <Border Grid.Column="3" Background="#3E3E42" Width="4"/>

        <!-- ═══════════════════════════════════════════════════════ -->
        <!-- КОЛОНКА 4: BATTLES + INSPECTOR                          -->
        <!-- ═══════════════════════════════════════════════════════ -->
        <Border Grid.Column="4" Background="#252526" Padding="8">
            <Border Background="#1E1E1E"
                    BorderBrush="#3E3E42"
                    BorderThickness="1"
                    CornerRadius="4">
                <Grid Margin="8" RowDefinitions="Auto,*,Auto,Auto">

                    <TextBlock Grid.Row="0"
                               Text="BATTLES"
                               Foreground="White"
                               FontWeight="Bold"
                               Margin="0,0,0,6"/>

                    <ListBox Grid.Row="1"
                             x:Name="BattlesList"
                             Background="#141414"
                             BorderBrush="#3E3E42"
                             BorderThickness="1"
                             SelectionChanged="OnBattleSelected">
                        <ListBox.ItemTemplate>
                            <DataTemplate x:DataType="core:BattleEntry">
                                <TextBlock Text="{Binding Name}" Foreground="#E0E0E0"/>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <TextBlock Grid.Row="2"
                               Text="INSPECTOR"
                               Foreground="White"
                               FontWeight="Bold"
                               Margin="0,10,0,6"/>

                    <Border Grid.Row="3"
                            x:Name="InspectorPanel"
                            IsVisible="False"
                            Background="#141414"
                            BorderBrush="#3E3E42"
                            BorderThickness="1"
                            CornerRadius="3"
                            Padding="6">
                        <Grid ColumnDefinitions="Auto,*,Auto">
                            <Button Grid.Column="0"
                                    x:Name="InspectorPrevBtn"
                                    Content="◄"
                                    Width="26" Height="26"
                                    Padding="0"
                                    FontSize="14"
                                    FontWeight="Bold"
                                    Click="OnInspectorPrevClick"/>
                            <TextBlock Grid.Column="1"
                                       x:Name="InspectorText"
                                       Foreground="#E0E0E0"
                                       FontSize="12"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"
                                       Text="—"/>
                            <Button Grid.Column="2"
                                    x:Name="InspectorNextBtn"
                                    Content="►"
                                    Width="26" Height="26"
                                    Padding="0"
                                    FontSize="14"
                                    FontWeight="Bold"
                                    Click="OnInspectorNextClick"/>
                        </Grid>
                    </Border>
                </Grid>
            </Border>
        </Border>
    </Grid>
</UserControl>