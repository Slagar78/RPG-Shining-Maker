<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="using:RpgShinzoMaker.Desktop.Views"
             xmlns:battleEditor="using:RpgShinzoMaker.Desktop.Editors.BattleEditor"
             xmlns:core="using:RpgShinzoMaker.Core.Models"
             x:Class="RpgShinzoMaker.Desktop.Editors.BattleEditor.BattleEditorView">

    <UserControl.Styles>
        <Style Selector="ComboBox.ModernComboBox">
            <Setter Property="Background" Value="#2D2D30"/>
            <Setter Property="BorderBrush" Value="#3E3E42"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="4"/>
            <Setter Property="Padding" Value="8,0"/>
            <Setter Property="Foreground" Value="#E0E0E0"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Height" Value="28"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>

        <Style Selector="TextBox">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Padding" Value="4,2"/>
            <Setter Property="Height" Value="26"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Background" Value="#333333"/>
            <Setter Property="BorderBrush" Value="#555555"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="CornerRadius" Value="4"/>
        </Style>

        <Style Selector="TextBox.NumBox">
            <Setter Property="TextAlignment" Value="Center"/>
            <Setter Property="Width" Value="45"/>
        </Style>

        <!-- Стиль для кнопок-стрелочек -->
        <Style Selector="Button.ArrowBtn, RepeatButton.ArrowBtn">
            <Setter Property="Background" Value="#444444"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Width" Value="24"/>
            <Setter Property="Height" Value="24"/>
            <Setter Property="CornerRadius" Value="2"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
        <Style Selector="Button.ArrowBtn:pointerover, RepeatButton.ArrowBtn:pointerover">
            <Setter Property="Background" Value="#666666"/>
        </Style>

        <!-- Стиль для маленьких стрелочек уровня -->
        <Style Selector="RepeatButton.ArrowBtn.Small">
            <Setter Property="Width" Value="18"/>
            <Setter Property="Height" Value="12"/>
            <Setter Property="FontSize" Value="8"/>
        </Style>

        <Style Selector="Border.hover-pulse">
            <Setter Property="BorderBrush" Value="#BF00FF"/>
            <Setter Property="BorderThickness" Value="3"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="Margin" Value="1"/>
            <Style.Animations>
                <Animation Duration="0:0:0.8" IterationCount="Infinite">
                    <KeyFrame Cue="0%"><Setter Property="Opacity" Value="1"/></KeyFrame>
                    <KeyFrame Cue="50%"><Setter Property="Opacity" Value="0.3"/></KeyFrame>
                    <KeyFrame Cue="100%"><Setter Property="Opacity" Value="1"/></KeyFrame>
                </Animation>
            </Style.Animations>
        </Style>
    </UserControl.Styles>

    <Grid ColumnDefinitions="250,4,*,4,200">
        
        <!-- ЛЕВАЯ КОЛОНКА -->
        <Border Grid.Column="0" Background="#252526" Padding="8">
            <Border Background="#1E1E1E" BorderBrush="#3E3E42" BorderThickness="1" CornerRadius="4">
                <Grid Margin="8" RowDefinitions="Auto,*,Auto,Auto,*,Auto">
                    <TextBlock Grid.Row="0" Text="ALLIES" Foreground="White" FontWeight="Bold" Margin="0,0,0,6"/>
                    <ListBox Grid.Row="1" x:Name="AlliesList" Background="Transparent" BorderThickness="0" 
                             SelectionChanged="OnAllySelectionChanged"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             ScrollViewer.VerticalScrollBarVisibility="Auto">
                        <ListBox.ItemsPanel>
                            <ItemsPanelTemplate><WrapPanel Orientation="Horizontal"/></ItemsPanelTemplate>
                        </ListBox.ItemsPanel>
                        <ListBox.Styles>
                            <Style Selector="ListBoxItem">
                                <Setter Property="Padding" Value="0"/><Setter Property="Margin" Value="1"/>
                                <Setter Property="Width" Value="34"/><Setter Property="Height" Value="34"/>
                                <Setter Property="Background" Value="Transparent"/>
                            </Style>
                            <Style Selector="ListBoxItem /template/ ContentPresenter">
                                <Setter Property="Background" Value="Transparent"/><Setter Property="Padding" Value="0"/><Setter Property="BorderThickness" Value="0"/>
                            </Style>
                        </ListBox.Styles>
                        <ListBox.ItemTemplate>
                            <DataTemplate DataType="battleEditor:BattleUnit">
                                <Border Background="#2A2A2A" BorderBrush="#3E3E42" BorderThickness="1" CornerRadius="6">
                                    <Grid>
                                        <Image Source="{Binding Image}" Stretch="Uniform" RenderOptions.BitmapInterpolationMode="None"/>
                                        <TextBlock Text="{Binding Id}" Foreground="Yellow" FontWeight="Bold" FontSize="10" Margin="2,0,0,0" IsVisible="{Binding Used}"/>
                                        <Border IsVisible="{Binding $parent[ListBoxItem].IsSelected}" BorderBrush="#BF00FF" BorderThickness="2" CornerRadius="6" Margin="1"/>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                    
                    <StackPanel Grid.Row="2" Orientation="Horizontal" Spacing="4" Margin="0,6">
                        <Button Content="+" MinWidth="30" Height="24" Padding="0" FontWeight="Bold" FontSize="16" Click="OnAddAllyClick"/>
                        <Button Content="−" MinWidth="30" Height="24" Padding="0" FontWeight="Bold" FontSize="16" Click="OnDeleteAllyClick"/>
                    </StackPanel>

                    <TextBlock Grid.Row="3" Text="ENEMIES" Foreground="White" FontWeight="Bold" Margin="0,0,0,6"/>
                    
                    <ListBox Grid.Row="4" x:Name="EnemiesList" Background="Transparent" BorderThickness="0" 
                             SelectionChanged="OnEnemySelectionChanged"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             ScrollViewer.VerticalScrollBarVisibility="Auto">
                        <ListBox.ItemsPanel>
                            <ItemsPanelTemplate><WrapPanel Orientation="Horizontal"/></ItemsPanelTemplate>
                        </ListBox.ItemsPanel>
                        <ListBox.Styles>
                            <Style Selector="ListBoxItem">
                                <Setter Property="Padding" Value="0"/><Setter Property="Margin" Value="1"/>
                                <Setter Property="Width" Value="34"/><Setter Property="Height" Value="34"/>
                                <Setter Property="Background" Value="Transparent"/>
                            </Style>
                            <Style Selector="ListBoxItem /template/ ContentPresenter">
                                <Setter Property="Background" Value="Transparent"/><Setter Property="Padding" Value="0"/><Setter Property="BorderThickness" Value="0"/>
                            </Style>
                        </ListBox.Styles>
                        <ListBox.ItemTemplate>
                            <DataTemplate DataType="battleEditor:BattleUnit">
                                <Border Background="#2A2A2A" BorderBrush="#3E3E42" BorderThickness="1" CornerRadius="6">
                                    <Grid>
                                        <Image Source="{Binding Image}" Stretch="Uniform" RenderOptions.BitmapInterpolationMode="None"/>
                                        <TextBlock Text="{Binding Id}" Foreground="Yellow" FontWeight="Bold" FontSize="10" Margin="2,0,0,0" IsVisible="{Binding Used}"/>
                                        <Border IsVisible="{Binding $parent[ListBoxItem].IsSelected}" BorderBrush="#BF00FF" BorderThickness="2" CornerRadius="6" Margin="1"/>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <StackPanel Grid.Row="5" Orientation="Horizontal" Spacing="4" Margin="0,6,0,0">
                        <Button Content="+" MinWidth="30" Height="24" Padding="0" FontWeight="Bold" FontSize="16" Click="OnAddEnemyClick"/>
                        <Button Content="−" MinWidth="30" Height="24" Padding="0" FontWeight="Bold" FontSize="16" Click="OnDeleteEnemyClick"/>
                    </StackPanel>
                </Grid>
            </Border>
        </Border>

        <Border Grid.Column="1" Background="#3E3E42" Width="4"/>

        <!-- ЦЕНТРАЛЬНАЯ ЧАСТЬ -->
        <Grid Grid.Column="2" RowDefinitions="Auto,*,Auto,Auto">
            
            <!-- ВЕРХНЯЯ ПАНЕЛЬ -->
            <Border Grid.Row="0" Background="#1E1E1E" BorderBrush="#3E3E42" BorderThickness="0,0,0,1" Padding="10,6">
                <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                    <ToggleButton x:Name="ModeBattleBtn" Content="Battle" IsChecked="True" Click="OnModeBattleClick"/>
                    <ToggleButton x:Name="ModeTerrainBtn" Content="Terrain" Click="OnModeTerrainClick"/>
                    <Border Width="1" Background="#3E3E42" Margin="4,0"/>
                    <ToggleButton x:Name="ZoneBtn" Content="Zone" Click="OnZoneToggleClick"/>
                    
                    <StackPanel x:Name="TerrainBrushesPanel" Orientation="Horizontal" Spacing="4" IsVisible="False" VerticalAlignment="Center">
                        <Button Content="B" Tag="-1" Click="OnTerrainBrushClick" Background="#E74C3C" Foreground="White" Width="28" Height="24" Padding="0" FontWeight="Bold"/>
                        <Button Content="F" Tag="0" Click="OnTerrainBrushClick" Background="#F1C40F" Foreground="Black" Width="28" Height="24" Padding="0" FontWeight="Bold"/>
                        <Button Content="W" Tag="1" Click="OnTerrainBrushClick" Background="#4CAF50" Foreground="White" Width="28" Height="24" Padding="0" FontWeight="Bold"/>
                    </StackPanel>
                    
                    <Border Width="1" Background="#3E3E42" Margin="4,0"/>
                    <Button Content="Save" FontWeight="Bold" Background="#C88A50" Foreground="White" Click="OnSaveClick"/>
                    <Border Width="1" Background="#3E3E42" Margin="4,0"/>
                    
                    <TextBlock Text="Zoom" Foreground="#AAAAAA" VerticalAlignment="Center"/>
                    <ComboBox x:Name="ZoomSelector" Classes="ModernComboBox" Width="90" SelectedIndex="2" SelectionChanged="OnZoomChanged">
                        <ComboBoxItem Content="1/4x"/><ComboBoxItem Content="1/2x"/><ComboBoxItem Content="1x"/><ComboBoxItem Content="2x"/><ComboBoxItem Content="4x"/>
                    </ComboBox>
                </StackPanel>
            </Border>

            <!-- КАРТА -->
            <Grid Grid.Row="1" ClipToBounds="True" Background="#1E1E1E">
                <views:MapCanvas x:Name="MapCanvasControl"/>
                <Canvas x:Name="OverlayCanvas" IsHitTestVisible="False" ClipToBounds="True"/>
            </Grid>

            <!-- ПАНЕЛЬ X, Y, W, H -->
            <Border Grid.Row="2" Background="#252526" BorderBrush="#3E3E42" BorderThickness="0,1,0,1" Padding="10,10" MinHeight="50">
                <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                    <TextBlock x:Name="BottomModeText" Foreground="#FFD700" Text="BATTLE ZONE" VerticalAlignment="Center" FontWeight="Bold" Margin="0,0,10,0"/>
                    
                    <StackPanel Orientation="Horizontal" Spacing="2">
                        <TextBlock Text="X:" Foreground="#AAAAAA" VerticalAlignment="Center" Margin="0,0,4,0"/>
                        <TextBox x:Name="BattlePosX" Classes="NumBox" TextChanged="OnZoneTextChanged"/>
                        <Grid RowDefinitions="*, *" Width="18">
                            <RepeatButton Grid.Row="0" Content="▲" Classes="ArrowBtn Small" Click="OnIncXClick" Delay="400" Interval="50"/>
                            <RepeatButton Grid.Row="1" Content="▼" Classes="ArrowBtn Small" Click="OnDecXClick" Delay="400" Interval="50" Margin="0,2,0,0"/>
                        </Grid>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" Spacing="2">
                        <TextBlock Text="Y:" Foreground="#AAAAAA" VerticalAlignment="Center" Margin="0,0,4,0"/>
                        <TextBox x:Name="BattlePosY" Classes="NumBox" TextChanged="OnZoneTextChanged"/>
                        <Grid RowDefinitions="*, *" Width="18">
                            <RepeatButton Grid.Row="0" Content="▲" Classes="ArrowBtn Small" Click="OnIncYClick" Delay="400" Interval="50"/>
                            <RepeatButton Grid.Row="1" Content="▼" Classes="ArrowBtn Small" Click="OnDecYClick" Delay="400" Interval="50" Margin="0,2,0,0"/>
                        </Grid>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" Spacing="2">
                        <TextBlock Text="W:" Foreground="#AAAAAA" VerticalAlignment="Center" Margin="0,0,4,0"/>
                        <TextBox x:Name="BattleSizeX" Classes="NumBox" TextChanged="OnZoneTextChanged"/>
                        <Grid RowDefinitions="*, *" Width="18">
                            <RepeatButton Grid.Row="0" Content="▲" Classes="ArrowBtn Small" Click="OnIncWClick" Delay="400" Interval="50"/>
                            <RepeatButton Grid.Row="1" Content="▼" Classes="ArrowBtn Small" Click="OnDecWClick" Delay="400" Interval="50" Margin="0,2,0,0"/>
                        </Grid>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" Spacing="2">
                        <TextBlock Text="H:" Foreground="#AAAAAA" VerticalAlignment="Center" Margin="0,0,4,0"/>
                        <TextBox x:Name="BattleSizeY" Classes="NumBox" TextChanged="OnZoneTextChanged"/>
                        <Grid RowDefinitions="*, *" Width="18">
                            <RepeatButton Grid.Row="0" Content="▲" Classes="ArrowBtn Small" Click="OnIncHClick" Delay="400" Interval="50"/>
                            <RepeatButton Grid.Row="1" Content="▼" Classes="ArrowBtn Small" Click="OnDecHClick" Delay="400" Interval="50" Margin="0,2,0,0"/>
                        </Grid>
                    </StackPanel>

                    <Border Width="1" Background="#3E3E42" Margin="10,0"/>
                    <TextBlock x:Name="BottomTerrainText" Foreground="#AAAAAA" Text="Terrain: Walkable" VerticalAlignment="Center"/>
                </StackPanel>
            </Border>

            <!-- ★ ИНСПЕКТОР (С ИДЕАЛЬНЫМИ ВЕКТОРНЫМИ СТРЕЛКАМИ) ★ -->
            <Border Grid.Row="3" Background="#1E1E1E" BorderBrush="#3E3E42" BorderThickness="0,1,0,0" Padding="15,10" MinHeight="100">
                <Grid>
                    <Border x:Name="InspectorPanel" IsVisible="False" Background="#141414" BorderBrush="#3E3E42" BorderThickness="1" CornerRadius="4" Padding="15,10" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="20,0,0,0">
                        <StackPanel Orientation="Vertical" Spacing="8">
                            
                            <!-- Строка 1: ID и Имя -->
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" Spacing="10">
                                
                                <!-- Левая стрелка (Идеальный треугольник через Path) -->
                                <Button x:Name="InspectorPrevBtn" Classes="ArrowBtn" Width="24" Height="24" Click="OnInspectorPrevClick">
                                    <Path Data="M 8,0 L 0,5 L 8,10 Z" Fill="White" Stretch="Uniform" Width="8" Height="10" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Button>
                                
                                <!-- Фиксированная ширина -->
                                <TextBlock x:Name="InspectorText" Width="180" TextAlignment="Center" Foreground="#E0E0E0" FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                
                                <!-- Правая стрелка (Идеальный треугольник через Path) -->
                                <Button x:Name="InspectorNextBtn" Classes="ArrowBtn" Width="24" Height="24" Click="OnInspectorNextClick">
                                    <Path Data="M 0,0 L 8,5 L 0,10 Z" Fill="White" Stretch="Uniform" Width="8" Height="10" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Button>
                                
                            </StackPanel>

                            <!-- Строка 2: Уровень (Виден ТОЛЬКО для врагов) -->
                            <StackPanel x:Name="InspectorLevelPanel" Orientation="Horizontal" HorizontalAlignment="Left" Spacing="6" IsVisible="False">
                                <TextBlock Text="Level:" Foreground="#AAAAAA" VerticalAlignment="Center" FontSize="14"/>
                                <TextBox x:Name="InspectorLevelBox" Classes="NumBox" Width="45" Height="26" TextChanged="OnInspectorLevelChanged"/>
                                <Grid RowDefinitions="*, *" Width="20">
                                    <RepeatButton Grid.Row="0" Content="▲" Classes="ArrowBtn Small" Click="OnInspectorIncLevelClick" Delay="400" Interval="50"/>
                                    <RepeatButton Grid.Row="1" Content="▼" Classes="ArrowBtn Small" Click="OnInspectorDecLevelClick" Delay="400" Interval="50" Margin="0,2,0,0"/>
                                </Grid>
                            </StackPanel>

                        </StackPanel>
                    </Border>
                </Grid>
            </Border>
        </Grid>

        <Border Grid.Column="3" Background="#3E3E42" Width="4"/>

        <!-- ПРАВАЯ КОЛОНКА -->
        <Border Grid.Column="4" Background="#252526" Padding="8">
            <Border Background="#1E1E1E" BorderBrush="#3E3E42" BorderThickness="1" CornerRadius="4">
                <Grid Margin="8" RowDefinitions="Auto,*">
                    <TextBlock Grid.Row="0" Text="BATTLES" Foreground="White" FontWeight="Bold" Margin="0,0,0,6"/>
                    <ListBox Grid.Row="1" x:Name="BattlesList" Background="#141414" BorderBrush="#3E3E42" BorderThickness="1" SelectionChanged="OnBattleSelected">
                        <ListBox.ItemTemplate>
                            <DataTemplate x:DataType="core:BattleEntry">
                                <TextBlock Text="{Binding Name}" Foreground="#E0E0E0"/>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </Border>
        </Border>
    </Grid>
</UserControl>