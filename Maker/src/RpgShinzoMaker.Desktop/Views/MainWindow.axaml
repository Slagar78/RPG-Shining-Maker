<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:mapEditor="using:RpgShinzoMaker.Desktop.Editors.MapEditor"
        mc:Ignorable="d" d:DesignWidth="1280" d:DesignHeight="720"
        x:Class="RpgShinzoMaker.Desktop.Views.MainWindow"
        Icon="/Assets/avalonia-logo.ico"
        Title="RpgShinzoMaker"
        Width="1400" Height="900"
        MinWidth="1280" MinHeight="720"
        WindowState="Maximized"
        WindowStartupLocation="CenterScreen">

    <Window.Styles>
        <Style Selector="ScrollBar">
            <Setter Property="Opacity" Value="1"/>
            <Setter Property="Background" Value="#1E1E1E"/>
        </Style>
        <Style Selector="ScrollBar:vertical">
            <Setter Property="Width" Value="10"/>
        </Style>
        <Style Selector="ScrollBar:horizontal">
            <Setter Property="Height" Value="10"/>
        </Style>
        <Style Selector="ScrollBar /template/ Thumb">
            <Setter Property="Background" Value="#007ACC"/>
            <Setter Property="Opacity" Value="1"/>
        </Style>
        <Style Selector="ScrollBar /template/ Thumb:pointerover">
            <Setter Property="Background" Value="#1E90FF"/>
        </Style>
        <Style Selector="ScrollBar /template/ Thumb:pressed">
            <Setter Property="Background" Value="#005A9E"/>
        </Style>
    </Window.Styles>

    <Grid ColumnDefinitions="*,4,320">

        <!-- КОЛОНКА 0: Тулбар + Вкладки + Статус-бар -->
        <DockPanel Grid.Column="0">

            <!-- ТУЛБАР -->
            <Border DockPanel.Dock="Top" Background="#2D2D30" Padding="8,6">
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <Button Content="💾 SAVE"
                            ToolTip.Tip="Сохранить (Ctrl+S)"
                            Background="#4CAF50"
                            Foreground="White"
                            FontWeight="Bold"
                            Padding="12,6"
                            Click="OnSaveClick"/>
                    <Separator Width="1" Margin="6,2"/>
                    <Button Content="▶ Запустить игру"  ToolTip.Tip="F5"/>
                    <Button Content="⚔ Запустить битву" ToolTip.Tip="F6"/>
                </StackPanel>
            </Border>

            <!-- СТАТУС-БАР -->
            <Border DockPanel.Dock="Bottom" Background="#007ACC" Padding="8,4">
                <Grid ColumnDefinitions="Auto,*,Auto">
                    <TextBlock x:Name="StatusText"
                               Grid.Column="0"
                               Text="Готово"
                               Foreground="White"/>
                    <TextBlock x:Name="StatusInfoText"
                               Grid.Column="1"
                               Text="Позиция: —    Зум: 1x"
                               Foreground="White"
                               HorizontalAlignment="Center"/>
                    <TextBlock Grid.Column="2"
                               Text="RPG-Shinzo"
                               Foreground="White"/>
                </Grid>
            </Border>

            <!-- ВКЛАДКИ -->
            <TabControl x:Name="EditorTabs"
                        SelectionChanged="OnTabChanged">

                <TabItem Header="Карты">
                    <mapEditor:MapEditorView x:Name="MapEditor"/>
                </TabItem>

                <TabItem Header="Эвенты">
                    <Border Background="#1E1E1E">
                        <TextBlock Text="Редактор событий"
                                   Foreground="Gray"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   FontSize="20"/>
                    </Border>
                </TabItem>

                <TabItem Header="Бои">
                    <Border Background="#1E1E1E">
                        <TextBlock Text="Редактор боёв"
                                   Foreground="Gray"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   FontSize="20"/>
                    </Border>
                </TabItem>

                <TabItem Header="Сцены">
                    <Border Background="#1E1E1E">
                        <TextBlock Text="Редактор боевых сцен"
                                   Foreground="Gray"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   FontSize="20"/>
                    </Border>
                </TabItem>

                <TabItem Header="База данных">
                    <Border Background="#1E1E1E">
                        <TextBlock Text="База данных"
                                   Foreground="Gray"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   FontSize="20"/>
                    </Border>
                </TabItem>
            </TabControl>
        </DockPanel>

        <!-- РАЗДЕЛИТЕЛЬ -->
        <GridSplitter Grid.Column="1"
                      Background="#3E3E42"
                      ResizeDirection="Columns"
                      Width="4"/>

<!-- КОЛОНКА 2: ASSETS + Свойства -->
        <Grid Grid.Column="2" RowDefinitions="*,4,280">

            <!-- ASSETS -->
            <Border Grid.Row="0" Background="#252526" Padding="8">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top"
                               Text="ASSETS"
                               Foreground="White"
                               FontWeight="Bold"
                               Margin="0,0,0,8"/>

                    <TreeView Background="Transparent">
                        <TreeViewItem Header="🗺 Maps" IsExpanded="True">
                            <TreeViewItem Header="Granseal"/>
                            <TreeViewItem Header="Ribble"/>
                            <TreeViewItem Header="Castle"/>
                        </TreeViewItem>

                        <TreeViewItem Header="⚔ Battles" IsExpanded="False">
                            <TreeViewItem Header="Battle 1 — Goblins"/>
                            <TreeViewItem Header="Battle 2 — Dark Mage"/>
                            <TreeViewItem Header="Battle 3 — Boss"/>
                        </TreeViewItem>

                        <TreeViewItem Header="🧙 Characters" IsExpanded="False">
                            <TreeViewItem Header="Bowie"/>
                            <TreeViewItem Header="Sarah"/>
                            <TreeViewItem Header="Chester"/>
                            <TreeViewItem Header="Jaha"/>
                        </TreeViewItem>

                        <TreeViewItem Header="🎒 Items" IsExpanded="False">
                            <TreeViewItem Header="🔧 Weapons">
                                <TreeViewItem Header="Iron Sword"/>
                                <TreeViewItem Header="Steel Lance"/>
                            </TreeViewItem>
                            <TreeViewItem Header="🛡 Armor">
                                <TreeViewItem Header="Leather Armor"/>
                                <TreeViewItem Header="Chain Mail"/>
                            </TreeViewItem>
                            <TreeViewItem Header="🧪 Potions">
                                <TreeViewItem Header="Herb"/>
                                <TreeViewItem Header="Antidote"/>
                            </TreeViewItem>
                        </TreeViewItem>

                        <TreeViewItem Header="✨ Spells" IsExpanded="False">
                            <TreeViewItem Header="Blaze"/>
                            <TreeViewItem Header="Heal"/>
                            <TreeViewItem Header="Bolt"/>
                        </TreeViewItem>

                        <TreeViewItem Header="👹 Enemies" IsExpanded="False">
                            <TreeViewItem Header="Goblin"/>
                            <TreeViewItem Header="Dark Mage"/>
                            <TreeViewItem Header="Dragon"/>
                        </TreeViewItem>

                        <TreeViewItem Header="🎬 Scenes" IsExpanded="False">
                            <TreeViewItem Header="Intro"/>
                            <TreeViewItem Header="Granseal's Fall"/>
                            <TreeViewItem Header="Final Battle"/>
                        </TreeViewItem>

                        <TreeViewItem Header="📜 Dialogues" IsExpanded="False">
                            <TreeViewItem Header="npc_granseal_01"/>
                            <TreeViewItem Header="battle_intro_01"/>
                            <TreeViewItem Header="ending"/>
                        </TreeViewItem>

                        <TreeViewItem Header="🎵 Music" IsExpanded="False">
                            <TreeViewItem Header="Track1.mp3"/>
                            <TreeViewItem Header="Track2.mp3"/>
                        </TreeViewItem>

                        <TreeViewItem Header="🖼 Sprites" IsExpanded="False">
                            <TreeViewItem Header="Tilesets"/>
                            <TreeViewItem Header="Characters"/>
                        </TreeViewItem>
                    </TreeView>
                </DockPanel>
            </Border>

            <!-- РАЗДЕЛИТЕЛЬ между ASSETS и Свойствами -->
            <GridSplitter Grid.Row="1"
                          Background="#3E3E42"
                          ResizeDirection="Rows"
                          Height="4"/>

            <!-- СВОЙСТВА -->
            <Border Grid.Row="2" Background="#252526" Padding="8">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top"
                               Text="СВОЙСТВА"
                               Foreground="White"
                               FontWeight="Bold"
                               Margin="0,0,0,8"/>
                    <ScrollViewer>
                        <StackPanel Spacing="8">
                            <TextBlock Text="Ничего не выбрано"
                                       Foreground="Gray"
                                       FontStyle="Italic"/>
                        </StackPanel>
                    </ScrollViewer>
                </DockPanel>
            </Border>
        </Grid>
    </Grid>
</Window>