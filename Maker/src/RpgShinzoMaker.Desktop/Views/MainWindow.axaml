<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:views="using:RpgShinzoMaker.Desktop.Views"
        mc:Ignorable="d" d:DesignWidth="1280" d:DesignHeight="720"
        x:Class="RpgShinzoMaker.Desktop.Views.MainWindow"
        Icon="/Assets/avalonia-logo.ico"
        Title="RpgShinzoMaker"
        Width="1400" Height="900"
        MinWidth="1280" MinHeight="720"
        WindowState="Maximized"
        WindowStartupLocation="CenterScreen">

    <Window.Styles>
        <Style Selector="Border.typeIcon.selected">
            <Style.Animations>
                <Animation Duration="0:0:0.8" IterationCount="Infinite">
                    <KeyFrame Cue="0%"><Setter Property="Opacity" Value="1"/></KeyFrame>
                    <KeyFrame Cue="50%"><Setter Property="Opacity" Value="0.25"/></KeyFrame>
                    <KeyFrame Cue="100%"><Setter Property="Opacity" Value="1"/></KeyFrame>
                </Animation>
            </Style.Animations>
        </Style>

        <Style Selector="ScrollBar">
            <Setter Property="Opacity" Value="1"/>
            <Setter Property="Background" Value="#1E1E1E"/>
        </Style>
        <Style Selector="ScrollBar:vertical">
            <Setter Property="Width" Value="10"/>
        </Style>
        <Style Selector="ScrollBar:horizontal">
            <Setter Property="Height" Value="10"/>
        </Style>
        <Style Selector="ScrollBar /template/ Thumb">
            <Setter Property="Background" Value="#007ACC"/>
            <Setter Property="Opacity" Value="1"/>
        </Style>
        <Style Selector="ScrollBar /template/ Thumb:pointerover">
            <Setter Property="Background" Value="#1E90FF"/>
        </Style>
        <Style Selector="ScrollBar /template/ Thumb:pressed">
            <Setter Property="Background" Value="#005A9E"/>
        </Style>
    </Window.Styles>

    <DockPanel>

        <!-- МЕНЮ -->
        <Menu DockPanel.Dock="Top">
            <MenuItem Header="_Файл">
                <MenuItem Header="_Новый проект" InputGesture="Ctrl+N"/>
                <MenuItem Header="_Открыть..." InputGesture="Ctrl+O"/>
                <MenuItem Header="_Сохранить" InputGesture="Ctrl+S"/>
                <Separator/>
                <MenuItem Header="_Выход"/>
            </MenuItem>
            <MenuItem Header="_Правка">
                <MenuItem Header="_Отменить" InputGesture="Ctrl+Z"/>
                <MenuItem Header="_Повторить" InputGesture="Ctrl+Y"/>
                <Separator/>
                <MenuItem Header="_Копировать" InputGesture="Ctrl+C"/>
                <MenuItem Header="_Вставить" InputGesture="Ctrl+V"/>
            </MenuItem>
        </Menu>

        <!-- ТУЛБАР -->
        <Border DockPanel.Dock="Top" Background="#2D2D30" Padding="8,6">
            <StackPanel Orientation="Horizontal" Spacing="6">
                <Button Content="💾 SAVE" 
                        ToolTip.Tip="Сохранить карту (Ctrl+S)" 
                        Background="#4CAF50" 
                        Foreground="White" 
                        FontWeight="Bold"
                        Padding="12,6"
                        Click="OnSaveClick"/>
                <Separator Width="1" Margin="6,2"/>
                <Button Content="▶ Запустить игру" ToolTip.Tip="F5"/>
                <Button Content="⚔ Запустить битву" ToolTip.Tip="F6"/>
                <Separator Width="1" Margin="6,2"/>
                <Button Content="↩" ToolTip.Tip="Отменить"/>
                <Button Content="↪" ToolTip.Tip="Повторить"/>
            </StackPanel>
        </Border>

        <!-- СТАТУС-БАР -->
        <Border DockPanel.Dock="Bottom" Background="#007ACC" Padding="8,4">
            <Grid ColumnDefinitions="Auto,*,Auto">
                <TextBlock Grid.Column="0" Text="Готово" Foreground="White"/>
                <TextBlock Grid.Column="1" Text="Позиция: X:0 Y:0    Зум: 100%"
                           Foreground="White" HorizontalAlignment="Center"/>
                <TextBlock Grid.Column="2" Text="RPG-Shinzo" Foreground="White"/>
            </Grid>
        </Border>

        <!-- ОСНОВНАЯ ОБЛАСТЬ -->
        <Grid ColumnDefinitions="305,0,*,4,192,4,320">

            <!-- ЛЕВАЯ КОЛОНКА: БЛОКСЕТ -->
            <Border Grid.Column="0" Background="#252526" Padding="8">
                <Border Background="#1E1E1E"
                        BorderBrush="#3E3E42"
                        BorderThickness="1"
                        CornerRadius="4">
                    <Grid Margin="8" RowDefinitions="Auto,Auto,Auto,384,Auto,Auto">

                        <TextBlock Grid.Row="0"
                                   Text="БЛОКСЕТ"
                                   Foreground="White"
                                   FontWeight="Bold"
                                   Margin="0,0,0,8"/>

                        <Button Grid.Row="1"
                                Content="Загрузить тайлсет"
                                HorizontalAlignment="Stretch"
                                Margin="0,0,0,8"
                                Click="OnLoadTilesetClick"/>

                        <Grid Grid.Row="2" ColumnDefinitions="*,*" Margin="0,0,0,8">
                            <ToggleButton x:Name="ModeA"
                                          Grid.Column="0"
                                          Content="A"
                                          IsChecked="True"
                                          HorizontalAlignment="Stretch"
                                          HorizontalContentAlignment="Center"
                                          Margin="0,0,2,0"
                                          Click="OnModeAClick"/>
                            <ToggleButton x:Name="ModeB"
                                          Grid.Column="1"
                                          Content="B"
                                          HorizontalAlignment="Stretch"
                                          HorizontalContentAlignment="Center"
                                          Margin="2,0,0,0"
                                          Click="OnModeBClick"/>
                        </Grid>

                        <!-- ПАЛИТРА -->
                        <ListBox x:Name="PaletteList"
                                 Grid.Row="3"
                                 Height="384"
                                 HorizontalAlignment="Stretch"
                                 VerticalAlignment="Top"
                                 Background="#1E1E1E"
                                 BorderThickness="0"
                                 Padding="0"
                                 SelectionChanged="OnPaletteSelectionChanged"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                 ScrollViewer.VerticalScrollBarVisibility="Visible"
                                 ScrollViewer.AllowAutoHide="False">
                            <ListBox.Styles>
                                <Style Selector="ListBoxItem">
                                    <Setter Property="Padding" Value="0"/>
                                    <Setter Property="Margin" Value="0"/>
                                    <Setter Property="MinHeight" Value="0"/>
                                    <Setter Property="MinWidth" Value="0"/>
                                    <Setter Property="HorizontalContentAlignment" Value="Left"/>
                                    <Setter Property="VerticalContentAlignment" Value="Top"/>
                                </Style>
                                <Style Selector="ListBoxItem /template/ ContentPresenter">
                                    <Setter Property="Background" Value="Transparent"/>
                                    <Setter Property="BorderThickness" Value="0"/>
                                    <Setter Property="Padding" Value="0"/>
                                    <Setter Property="CornerRadius" Value="0"/>
                                </Style>
                                <Style Selector="ListBoxItem:pointerover /template/ ContentPresenter">
                                    <Setter Property="Background" Value="Transparent"/>
                                </Style>
                                <Style Selector="ListBoxItem:selected /template/ ContentPresenter">
                                    <Setter Property="Background" Value="Transparent"/>
                                </Style>
                            </ListBox.Styles>
                            <ListBox.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel Orientation="Horizontal"
                                               Width="256"
                                               HorizontalAlignment="Left"/>
                                </ItemsPanelTemplate>
                            </ListBox.ItemsPanel>
                            <ListBox.ItemTemplate>
                                <DataTemplate DataType="views:TileItem">
                                    <Grid Width="32" Height="32"
                                          Background="#1E1E1E"
                                          ClipToBounds="True"
                                          Tag="{Binding}"
                                          PointerPressed="OnPaletteItemPointerPressed"
                                          PointerMoved="OnPaletteItemPointerMoved">
                                        <Image Source="{Binding Image}"
                                               Stretch="Fill"
                                               RenderOptions.BitmapInterpolationMode="None"
                                               RenderOptions.EdgeMode="Aliased"
                                               IsHitTestVisible="False"/>
                                        <Border BorderBrush="#3E3E42"
                                                BorderThickness="0,0,1,1"
                                                IsHitTestVisible="False"/>
                                        <Border Width="8" Height="8"
                                                HorizontalAlignment="Right"
                                                VerticalAlignment="Bottom"
                                                Margin="0,0,1,1"
                                                CornerRadius="4"
                                                Background="{Binding TileColor}"
                                                IsVisible="{Binding ShowType}"
                                                IsHitTestVisible="False"/>
                                        <Border BorderBrush="#FFD700"
                                                BorderThickness="2"
                                                IsVisible="{Binding LeftSelected}"
                                                IsHitTestVisible="False"/>
                                        <Border BorderBrush="#FF2222"
                                                BorderThickness="2"
                                                IsVisible="{Binding RightSelected}"
                                                IsHitTestVisible="False"/>
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>

                        <!-- ПРЕВЬЮ: A → два квадрата, B → круг -->
                        <Border Grid.Row="4"
                                Background="#1E1E1E"
                                BorderBrush="#3E3E42"
                                BorderThickness="1"
                                CornerRadius="3"
                                Margin="0,8,0,0"
                                Padding="8">
                            <Grid>
                                <Grid x:Name="ModeAPreviewGrid" ColumnDefinitions="*,*">
                                    <StackPanel Grid.Column="0" Spacing="4" HorizontalAlignment="Center">
                                        <TextBlock Text="Left click"
                                                   Foreground="#AAAAAA"
                                                   FontSize="10"
                                                   HorizontalAlignment="Center"/>
                                        <Border CornerRadius="10"
                                                BorderBrush="#555555"
                                                BorderThickness="1"
                                                Width="60" Height="60"
                                                HorizontalAlignment="Center"
                                                Background="#0E0E0E"
                                                ClipToBounds="True">
                                            <Image x:Name="LeftClickPreview"
                                                   Stretch="Fill"
                                                   RenderOptions.BitmapInterpolationMode="None"
                                                   RenderOptions.EdgeMode="Aliased"/>
                                        </Border>
                                        <TextBlock x:Name="LeftClickLabel"
                                                   Text="—"
                                                   Foreground="#888888"
                                                   FontSize="10"
                                                   HorizontalAlignment="Center"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Spacing="4" HorizontalAlignment="Center">
                                        <TextBlock Text="Right click"
                                                   Foreground="#AAAAAA"
                                                   FontSize="10"
                                                   HorizontalAlignment="Center"/>
                                        <Border CornerRadius="10"
                                                BorderBrush="#555555"
                                                BorderThickness="1"
                                                Width="60" Height="60"
                                                HorizontalAlignment="Center"
                                                Background="#0E0E0E"
                                                ClipToBounds="True">
                                            <Image x:Name="RightClickPreview"
                                                   Stretch="Fill"
                                                   RenderOptions.BitmapInterpolationMode="None"
                                                   RenderOptions.EdgeMode="Aliased"/>
                                        </Border>
                                        <TextBlock x:Name="RightClickLabel"
                                                   Text="—"
                                                   Foreground="#888888"
                                                   FontSize="10"
                                                   HorizontalAlignment="Center"/>
                                    </StackPanel>
                                </Grid>

                                <StackPanel x:Name="ModeBPreviewPanel"
                                            Spacing="4"
                                            HorizontalAlignment="Center"
                                            IsVisible="False">
                                    <TextBlock Text="Selected type"
                                               Foreground="#AAAAAA"
                                               FontSize="10"
                                               HorizontalAlignment="Center"/>
                                    <Border CornerRadius="30"
                                            BorderBrush="#555555"
                                            BorderThickness="1"
                                            Width="60" Height="60"
                                            HorizontalAlignment="Center"
                                            Background="#0E0E0E">
                                        <Ellipse x:Name="TypePreviewEllipse"
                                                 Width="40" Height="40"
                                                 Fill="#4CAF50"
                                                 HorizontalAlignment="Center"
                                                 VerticalAlignment="Center"/>
                                    </Border>
                                    <TextBlock x:Name="TypePreviewLabel"
                                               Text="Passable"
                                               Foreground="#888888"
                                               FontSize="10"
                                               HorizontalAlignment="Center"/>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <!-- НИЖНЯЯ ПАНЕЛЬ -->
                        <Border Grid.Row="5"
                                Background="#252526"
                                BorderBrush="#3E3E42"
                                BorderThickness="0,1,0,0"
                                Padding="8,4"
                                Margin="0,8,0,0">
                            <StackPanel Spacing="4">

                                <Grid ColumnDefinitions="Auto,Auto,*,Auto">
                                    <TextBlock x:Name="PaletteStatus"
                                               Grid.Column="0"
                                               Text="✗"
                                               Foreground="#E74C3C"
                                               FontSize="14"
                                               FontWeight="Bold"
                                               VerticalAlignment="Center"
                                               Margin="0,0,6,0"/>
                                    <TextBlock x:Name="PaletteInfo"
                                               Grid.Column="1"
                                               Text="Тайлов: 0"
                                               Foreground="#AAAAAA"
                                               FontSize="12"
                                               VerticalAlignment="Center"/>
                                    <TextBlock Grid.Column="3"
                                               Text="48×48"
                                               Foreground="#666666"
                                               FontSize="12"
                                               VerticalAlignment="Center"/>
                                </Grid>

                                <Border Background="#1E1E1E"
                                        BorderBrush="#3E3E42"
                                        BorderThickness="1"
                                        CornerRadius="3"
                                        Padding="4,3">
                                    <Grid ColumnDefinitions="Auto,Auto,*,Auto,Auto,Auto,Auto">
                                        <TextBlock Grid.Column="0"
                                                   Text="Grid"
                                                   Foreground="#AAAAAA"
                                                   FontSize="11"
                                                   VerticalAlignment="Center"
                                                   Margin="0,0,6,0"/>
                                        <ToggleButton x:Name="GridModeToggle"
                                                      Grid.Column="1"
                                                      Content="OFF"
                                                      FontSize="10"
                                                      Padding="6,1"
                                                      MinHeight="0"
                                                      Click="OnGridModeClick"/>
                                        <Border Grid.Column="3"
                                                x:Name="TypeIcon0"
                                                Classes="typeIcon"
                                                Width="18" Height="18"
                                                Background="#4CAF50"
                                                Margin="2,0"
                                                BorderBrush="#FFFFFF"
                                                BorderThickness="2"
                                                CornerRadius="9"
                                                Cursor="Hand"
                                                Tag="0"
                                                PointerPressed="OnTileTypeClick"/>
                                        <Border Grid.Column="4"
                                                x:Name="TypeIcon1"
                                                Classes="typeIcon"
                                                Width="18" Height="18"
                                                Background="#E74C3C"
                                                Margin="2,0"
                                                BorderBrush="#555555"
                                                BorderThickness="2"
                                                CornerRadius="9"
                                                Cursor="Hand"
                                                Tag="1"
                                                PointerPressed="OnTileTypeClick"/>
                                        <Border Grid.Column="5"
                                                x:Name="TypeIcon2"
                                                Classes="typeIcon"
                                                Width="18" Height="18"
                                                Background="#3498DB"
                                                Margin="2,0"
                                                BorderBrush="#555555"
                                                BorderThickness="2"
                                                CornerRadius="9"
                                                Cursor="Hand"
                                                Tag="2"
                                                PointerPressed="OnTileTypeClick"/>
                                        <Border Grid.Column="6"
                                                x:Name="TypeIcon3"
                                                Classes="typeIcon"
                                                Width="18" Height="18"
                                                Background="#E67E22"
                                                Margin="2,0"
                                                BorderBrush="#555555"
                                                BorderThickness="2"
                                                CornerRadius="9"
                                                Cursor="Hand"
                                                Tag="3"
                                                PointerPressed="OnTileTypeClick"/>
                                    </Grid>
                                </Border>
                            </StackPanel>
                        </Border>
                    </Grid>
                </Border>
            </Border>

            <!-- ЦЕНТР: Карты / Эвенты -->
            <Grid Grid.Column="2" RowDefinitions="*,Auto">
                <TabControl Grid.Row="0">
                    <TabItem Header="Карты">
                        <views:MapCanvas x:Name="MapCanvasControl"/>
                    </TabItem>
                    <TabItem Header="Эвенты">
                        <Border Background="#1E1E1E">
                            <TextBlock Text="Редактор событий"
                                       Foreground="Gray"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"
                                       FontSize="20"/>
                        </Border>
                    </TabItem>
                </TabControl>

                <Border Grid.Row="1" Background="#252526" Padding="8,6">
                    <StackPanel Orientation="Horizontal" Spacing="12">
                        <TextBlock Text="Карта:" Foreground="White" VerticalAlignment="Center"/>
                        <ComboBox x:Name="MapSelector"
                                  MinWidth="180"
                                  VerticalAlignment="Center"
                                  SelectionChanged="OnMapSelectorChanged"/>
                        <TextBlock Text="Размер:" Foreground="White" VerticalAlignment="Center"/>
                        <TextBlock x:Name="MapSizeText" Text="—" Foreground="#4CAF50" VerticalAlignment="Center"/>
                        <TextBlock Text="Тайлсет:" Foreground="White" VerticalAlignment="Center"/>
                        <TextBlock x:Name="MapTilesetText" Text="—" Foreground="#4CAF50" VerticalAlignment="Center"/>
                        <TextBlock Text="Музыка:" Foreground="White" VerticalAlignment="Center"/>
                        <ComboBox x:Name="MapMusicSelector"
                                  MinWidth="180"
                                  VerticalAlignment="Center"
                                  SelectionChanged="OnMapMusicChanged"/>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- РАЗДЕЛИТЕЛЬ -->
            <GridSplitter Grid.Column="3" Background="#3E3E42"
                          ResizeDirection="Columns" Width="4"/>

            <!-- ▶ ПАНЕЛЬ ИНСТРУМЕНТОВ -->
            <Border Grid.Column="4" Background="#252526" Padding="8">
                <Border Background="#1E1E1E"
                        BorderBrush="#3E3E42"
                        BorderThickness="1"
                        CornerRadius="4">
                    <DockPanel Margin="8">
                        <TextBlock DockPanel.Dock="Top"
                                   Text="ИНСТРУМЕНТЫ"
                                   Foreground="White"
                                   FontWeight="Bold"
                                   FontSize="12"
                                   Margin="0,0,0,10"/>

<StackPanel Spacing="6" VerticalAlignment="Top" HorizontalAlignment="Stretch">

    <!-- Ряд 1: L1 / L2 / Active Layer -->
    <UniformGrid Columns="3">
        <ToggleButton x:Name="Layer1Toggle"
                      Content="L1"
                      FontSize="14" FontWeight="Bold"
                      Width="48" Height="40" Margin="1"
                      IsChecked="True"
                      Background="#4CAF50" Foreground="White"
                      Click="OnLayer1ToggleClick"/>

        <ToggleButton x:Name="Layer2Toggle"
                      Content="L2"
                      FontSize="14" FontWeight="Bold"
                      Width="48" Height="40" Margin="1"
                      IsChecked="True"
                      Background="#4CAF50" Foreground="White"
                      Click="OnLayer2ToggleClick"/>

        <Button x:Name="ActiveLayerButton"
                Content="1"
                FontSize="14" FontWeight="Bold"
                Width="48" Height="40" Margin="1"
                Background="#6497C8" Foreground="White"
                Click="OnActiveLayerClick"/>
    </UniformGrid>

    <!-- Ряд 2: Tile Editor -->
    <ToggleButton x:Name="TileEditorToggle"
                  FontSize="12" FontWeight="Bold"
                  Height="32"
                  HorizontalAlignment="Stretch"
                  HorizontalContentAlignment="Center"
                  Click="OnTileEditorToggle">
        <StackPanel Orientation="Horizontal" Spacing="6" HorizontalAlignment="Center">
            <TextBlock x:Name="TileEditorIcon"
                       Text="✗"
                       FontSize="16"
                       FontWeight="Bold"
                       Foreground="#E74C3C"
                       VerticalAlignment="Center"/>
            <TextBlock Text="Tile Editor"
                       VerticalAlignment="Center"/>
        </StackPanel>
    </ToggleButton>

    <!-- Ряд 3: 4 кнопки трансформации (2x2) -->
    <UniformGrid Columns="2">
        <Button x:Name="RotateBtn"
                Content="🔄" FontSize="26"
                Width="72" Height="72" Margin="1"
                IsEnabled="False"
                BorderThickness="3" BorderBrush="#3E3E42"
                Click="OnRotateClick"/>

        <Button x:Name="FlipHBtn"
                Content="↔" FontSize="26"
                Width="72" Height="72" Margin="1"
                IsEnabled="False"
                BorderThickness="3" BorderBrush="#3E3E42"
                Click="OnFlipHClick"/>

        <Button x:Name="FlipVBtn"
                Content="↕" FontSize="26"
                Width="72" Height="72" Margin="1"
                IsEnabled="False"
                BorderThickness="3" BorderBrush="#3E3E42"
                Click="OnFlipVClick"/>

        <Button x:Name="DeleteBtn"
                Content="❌" FontSize="26"
                Width="72" Height="72" Margin="1"
                IsEnabled="False"
                BorderThickness="3" BorderBrush="#3E3E42"
                Click="OnDeleteClick"/>
    </UniformGrid>

    <!-- Ряд 4: Left / Right preview (для карты) -->
    <UniformGrid Columns="2" Margin="0,8,0,0">
        <StackPanel Spacing="2" HorizontalAlignment="Center">
            <TextBlock Text="Left click" Foreground="#AAAAAA" FontSize="10" HorizontalAlignment="Center"/>
            <Border Width="60" Height="60"
                    CornerRadius="10"
                    BorderBrush="#555555" BorderThickness="1"
                    Background="#0E0E0E"
                    ClipToBounds="True">
                <Image x:Name="MapLeftPreview"
                       Stretch="Fill"
                       RenderOptions.BitmapInterpolationMode="None"
                       RenderOptions.EdgeMode="Aliased"/>
            </Border>
            <TextBlock x:Name="MapLeftLabel"
                       Text="—" Foreground="#888888" FontSize="10"
                       HorizontalAlignment="Center"/>
        </StackPanel>

        <StackPanel Spacing="2" HorizontalAlignment="Center">
            <TextBlock Text="Right click" Foreground="#AAAAAA" FontSize="10" HorizontalAlignment="Center"/>
            <Border Width="60" Height="60"
                    CornerRadius="10"
                    BorderBrush="#555555" BorderThickness="1"
                    Background="#0E0E0E"
                    ClipToBounds="True">
                <Image x:Name="MapRightPreview"
                       Stretch="Fill"
                       RenderOptions.BitmapInterpolationMode="None"
                       RenderOptions.EdgeMode="Aliased"/>
            </Border>
            <TextBlock x:Name="MapRightLabel"
            Text="—" Foreground="#888888" FontSize="10"
            HorizontalAlignment="Center"/>
                              </StackPanel>
                            </UniformGrid>
    <!-- Ряд 5: Grid Mode -->
    <ToggleButton x:Name="GridModeButton"
                  Content="Grid Mode"
                  FontSize="12" FontWeight="Bold"
                  Height="32" Margin="0,8,0,0"
                  HorizontalAlignment="Stretch"
                  HorizontalContentAlignment="Center"
                  Background="#3E3E42"
                  Foreground="White"
                  Click="OnGridModeToggle"/>

                <!-- Ряд 6: Zoom -->
                <StackPanel Orientation="Horizontal" Margin="0,8,0,0" Spacing="6"
                            HorizontalAlignment="Center">
                    <TextBlock Text="Zoom"
                               VerticalAlignment="Center"
                               Foreground="#AAAAAA"
                               FontSize="12"/>
                    <ComboBox x:Name="ZoomSelector"
                              Width="100"
                              SelectedIndex="2"
                              SelectionChanged="OnZoomChanged">
                        <ComboBoxItem Content="1/4x"/>
                        <ComboBoxItem Content="1/2x"/>
                        <ComboBoxItem Content="1x"/>
                        <ComboBoxItem Content="2x"/>
                        <ComboBoxItem Content="4x"/>
                    </ComboBox>
                </StackPanel>

            </StackPanel>
                    </DockPanel>
                </Border>
            </Border>

            <!-- РАЗДЕЛИТЕЛЬ 2 -->
            <GridSplitter Grid.Column="5" Background="#3E3E42"
                          ResizeDirection="Columns" Width="4"/>

            <!-- ПРАВАЯ КОЛОНКА (номер колонки меняем с 4 на 6) -->
            <Grid Grid.Column="6" RowDefinitions="*,4,280">
                <Border Grid.Row="0" Background="#252526" Padding="8">
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Top" Text="ДЕРЕВО ПРОЕКТА"
                                   Foreground="White" FontWeight="Bold"
                                   Margin="0,0,0,8"/>
                        <TreeView Background="Transparent">
                            <TreeViewItem Header="📁 Проект" IsExpanded="True">
                                <TreeViewItem Header="⚔ Бои">
                                    <TreeViewItem Header="Бой 1"/>
                                    <TreeViewItem Header="Бой 2"/>
                                </TreeViewItem>
                                <TreeViewItem Header="🎬 Боевые сцены">
                                    <TreeViewItem Header="Атака"/>
                                    <TreeViewItem Header="Защита"/>
                                </TreeViewItem>
                                <TreeViewItem Header="📜 Тексты">
                                    <TreeViewItem Header="0001"/>
                                    <TreeViewItem Header="0002"/>
                                </TreeViewItem>
                                <TreeViewItem Header="📁 assets">
                                    <TreeViewItem Header="tilesets"/>
                                    <TreeViewItem Header="sprites"/>
                                </TreeViewItem>
                            </TreeViewItem>
                        </TreeView>
                    </DockPanel>
                </Border>

                <GridSplitter Grid.Row="1" Background="#3E3E42"
                              ResizeDirection="Rows" Height="4"/>

                <Border Grid.Row="2" Background="#252526" Padding="8">
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Top" Text="СВОЙСТВА"
                                   Foreground="White" FontWeight="Bold"
                                   Margin="0,0,0,8"/>
                        <ScrollViewer>
                            <StackPanel Spacing="8">
                                <TextBlock Text="Ничего не выбрано"
                                           Foreground="Gray"
                                           FontStyle="Italic"/>
                            </StackPanel>
                        </ScrollViewer>
                    </DockPanel>
                </Border>
            </Grid>

        </Grid>
    </DockPanel>
</Window>