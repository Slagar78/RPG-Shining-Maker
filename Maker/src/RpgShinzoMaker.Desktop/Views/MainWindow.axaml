<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:mapEditor="using:RpgShinzoMaker.Desktop.Editors.MapEditor"
        xmlns:eventEditor="using:RpgShinzoMaker.Desktop.Editors.EventEditor"
        xmlns:importer="using:RpgShinzoMaker.Desktop.Editors.TilesetImporter"
        xmlns:dbEditor="using:RpgShinzoMaker.Desktop.Editors.DatabaseEditor"
        xmlns:battleEditor="using:RpgShinzoMaker.Desktop.Editors.BattleEditor"
        xmlns:audio="using:RpgShinzoMaker.Desktop.Shared.Audio"
        mc:Ignorable="d" d:DesignWidth="1280" d:DesignHeight="720"
        x:Class="RpgShinzoMaker.Desktop.Views.MainWindow"
        Icon="/Assets/shinzo.ico"
        Title="RpgShinzoMaker"
        Width="1400" Height="900"
        MinWidth="1280" MinHeight="720"
        WindowState="Maximized"
        WindowStartupLocation="CenterScreen">

    <Window.Styles>
        <!-- Скроллбары (оставили как было) -->
        <Style Selector="ScrollBar">
            <Setter Property="Opacity" Value="1"/>
            <Setter Property="Background" Value="#1E1E1E"/>
        </Style>
        <Style Selector="ScrollBar:vertical">
            <Setter Property="Width" Value="10"/>
        </Style>
        <Style Selector="ScrollBar:horizontal">
            <Setter Property="Height" Value="10"/>
        </Style>
        <Style Selector="ScrollBar /template/ Thumb">
            <Setter Property="Background" Value="#007ACC"/>
            <Setter Property="Opacity" Value="1"/>
        </Style>
        <Style Selector="ScrollBar /template/ Thumb:pointerover">
            <Setter Property="Background" Value="#1E90FF"/>
        </Style>
        <Style Selector="ScrollBar /template/ Thumb:pressed">
            <Setter Property="Background" Value="#005A9E"/>
        </Style>

        <!-- ★ СТИЛИ ДЛЯ ВКЛАДОК ★ -->
        <Style Selector="TabControl">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Padding" Value="0"/>
        </Style>

        <!-- Невыбранные вкладки -->
        <Style Selector="TabItem">
            <Setter Property="Background" Value="#1E1E1E"/>
            <Setter Property="Foreground" Value="#888888"/>
            <Setter Property="Margin" Value="2,4,0,0"/>
            <Setter Property="Padding" Value="16,6"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="CornerRadius" Value="6,6,0,0"/>
            <Setter Property="Template">
                <ControlTemplate>
                    <Border Name="PART_Border"
                            Background="{TemplateBinding Background}"
                            CornerRadius="{TemplateBinding CornerRadius}"
                            Padding="{TemplateBinding Padding}"
                            BorderThickness="0,2,0,0" 
                            BorderBrush="Transparent">
                        <ContentPresenter Content="{TemplateBinding Header}"
                                          TextElement.Foreground="{TemplateBinding Foreground}"
                                          HorizontalAlignment="Center"
                                          VerticalAlignment="Center"/>
                    </Border>
                </ControlTemplate>
            </Setter>
        </Style>

        <Style Selector="TabItem:pointerover /template/ Border#PART_Border">
            <Setter Property="Background" Value="#2D2D30"/>
        </Style>
        <Style Selector="TabItem:pointerover">
            <Setter Property="Foreground" Value="#CCCCCC"/>
        </Style>

        <Style Selector="TabItem:selected /template/ Border#PART_Border">
            <Setter Property="Background" Value="#2D2D30"/>
            <Setter Property="BorderBrush" Value="#007ACC"/>
        </Style>
        <Style Selector="TabItem:selected">
            <Setter Property="Foreground" Value="White"/>
        </Style>
    </Window.Styles>

    <Grid ColumnDefinitions="*,4,250">

        <!-- КОЛОНКА 0: Тулбар + Вкладки + Статус-бар -->
        <DockPanel Grid.Column="0">

            <!-- ТУЛБАР -->
            <Border DockPanel.Dock="Top" Background="#2D2D30" Padding="8,6">
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <Button Content="💾 SAVE"
                            ToolTip.Tip="Сохранить (Ctrl+S)"
                            Background="#4CAF50"
                            Foreground="White"
                            FontWeight="Bold"
                            Padding="12,6"
                            Click="OnSaveClick"/>
                    <Separator Width="1" Margin="6,2"/>
                    <Button Content="▶ Play Game"  
                            ToolTip.Tip="Запустить игру (F5)" 
                            Click="OnPlaytestClick"/>
                    <Button Content="⚔ Battle Test" 
                            ToolTip.Tip="Запустить битву (в разработке)" 
                            IsEnabled="False"/>
                </StackPanel>
            </Border>

            <!-- СТАТУС-БАР -->
            <Border DockPanel.Dock="Bottom" Background="#007ACC" Padding="8,4">
                <Grid ColumnDefinitions="Auto,*,Auto">
                    <TextBlock x:Name="StatusText"
                               Grid.Column="0"
                               Text="Готово"
                               Foreground="White"/>
                    <TextBlock x:Name="StatusInfoText"
                               Grid.Column="1"
                               Text="Позиция: —    Зум: 1x"
                               Foreground="White"
                               HorizontalAlignment="Center"/>
                    <TextBlock Grid.Column="2"
                               Text="RPG-Shinzo"
                               Foreground="White"/>
                </Grid>
            </Border>

            <!-- ВКЛАДКИ -->
            <TabControl x:Name="EditorTabs"
                        SelectionChanged="OnTabChanged">

                <TabItem Header="Maps">
                    <mapEditor:MapEditorView x:Name="MapEditor"/>
                </TabItem>

                <TabItem Header="Events">
                    <eventEditor:EventEditorView x:Name="EventEditor"/>
                </TabItem>
                
                <TabItem Header="Map Importer">
                    <importer:TilesetImporterView x:Name="TilesetImporter"/>
                </TabItem>

                <!-- ★ ЗАМЕНЕНО: теперь настоящий BattleEditor ★ -->
                <TabItem Header="Battles">
                    <battleEditor:BattleEditorView x:Name="BattleEditorControl"/>
                </TabItem>

                <TabItem Header="Scenes">
                    <Border Background="#1E1E1E">
                        <TextBlock Text="Scene Editor"
                                   Foreground="Gray"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   FontSize="20"/>
                    </Border>
                </TabItem>

                <TabItem Header="Database">
                    <dbEditor:DatabaseEditorView x:Name="DatabaseEditor"/>
                </TabItem>
            </TabControl>
        </DockPanel>


        <Grid Grid.Column="2" RowDefinitions="*,4,280">

            <!-- ═══ КОЛОНКА 2, ВЕРХ — ПЛЕЕР + ПЛЕЙЛИСТ ═══ -->
            <Border Grid.Row="0" Background="#252526" Padding="10">
                <DockPanel>

                    <!-- Заголовок -->
                    <TextBlock DockPanel.Dock="Top"
                               Text="🎵 MUSIC"
                               Foreground="#888888"
                               FontWeight="Bold"
                               Margin="0,0,0,8"/>

                    <!-- Управление прижато к низу -->
                    <Border DockPanel.Dock="Bottom"
                            Background="#1E1E1E"
                            Padding="10"
                            Margin="0,8,0,0"
                            CornerRadius="6">
                        <StackPanel Spacing="8">
                            <TextBlock x:Name="NowPlayingText"
                                       Text="Ничего не играет"
                                       Foreground="#CCCCCC"
                                       FontSize="12"
                                       HorizontalAlignment="Center"
                                       TextTrimming="CharacterEllipsis"/>

                                  <!-- ★ 5 КНОПОК С ВЕКТОРНЫМИ ИКОНКАМИ ★ -->
                                  <StackPanel Orientation="Horizontal" Spacing="4" HorizontalAlignment="Center">
                                      
                                      <!-- Назад (Prev) -->
                                      <Button x:Name="PrevBtn" Width="38" Height="38" CornerRadius="8"
                                              Background="#3E3E42" BorderBrush="Black" BorderThickness="2"
                                              Padding="0" HorizontalContentAlignment="Center" VerticalContentAlignment="Center"
                                              Click="OnPrevClick" ToolTip.Tip="Предыдущий трек">
                                          <Path Data="M 10,0 L 0,6 L 10,12 Z M 20,0 L 10,6 L 20,12 Z" Fill="White" Stretch="Uniform" Width="14" Height="12" />
                                      </Button>

                                      <!-- Играть (Play) -->
                                      <Button x:Name="PlayBtn" Width="38" Height="38" CornerRadius="8"
                                              Background="#3E3E42" BorderBrush="Black" BorderThickness="2"
                                              Padding="0" HorizontalContentAlignment="Center" VerticalContentAlignment="Center"
                                              Click="OnPlayClick" ToolTip.Tip="Играть">
                                          <Path Data="M 0,0 L 12,6 L 0,12 Z" Fill="White" Stretch="Uniform" Width="12" Height="12" Margin="2,0,0,0" />
                                      </Button>

                                      <!-- Пауза (Pause) -->
                                      <Button x:Name="PauseBtn" Width="38" Height="38" CornerRadius="8"
                                              Background="#3E3E42" BorderBrush="Black" BorderThickness="2"
                                              Padding="0" HorizontalContentAlignment="Center" VerticalContentAlignment="Center"
                                              Click="OnPauseClick" ToolTip.Tip="Пауза">
                                          <Path Data="M 0,0 L 4,0 L 4,12 L 0,12 Z M 8,0 L 12,0 L 12,12 L 8,12 Z" Fill="White" Stretch="Uniform" Width="10" Height="12" />
                                      </Button>

                                      <!-- Стоп (Stop) -->
                                      <Button x:Name="StopBtn" Width="38" Height="38" CornerRadius="8"
                                              Background="#3E3E42" BorderBrush="Black" BorderThickness="2"
                                              Padding="0" HorizontalContentAlignment="Center" VerticalContentAlignment="Center"
                                              Click="OnStopClick" ToolTip.Tip="Стоп">
                                          <Path Data="M 0,0 L 12,0 L 12,12 L 0,12 Z" Fill="White" Stretch="Uniform" Width="11" Height="11" />
                                      </Button>

                                      <!-- Вперёд (Next) -->
                                      <Button x:Name="NextBtn" Width="38" Height="38" CornerRadius="8"
                                              Background="#3E3E42" BorderBrush="Black" BorderThickness="2"
                                              Padding="0" HorizontalContentAlignment="Center" VerticalContentAlignment="Center"
                                              Click="OnNextClick" ToolTip.Tip="Следующий трек">
                                          <Path Data="M 0,0 L 10,6 L 0,12 Z M 10,0 L 20,6 L 10,12 Z" Fill="White" Stretch="Uniform" Width="14" Height="12" />
                                      </Button>

                                  </StackPanel>

                            <Grid ColumnDefinitions="Auto,*">
                                <TextBlock Grid.Column="0" Text="🔊" Foreground="#888888"
                                           VerticalAlignment="Center" Margin="0,0,6,0"/>
                                <Slider Grid.Column="1" x:Name="VolumeSlider"
                                        Minimum="0" Maximum="100" Value="80"
                                        ValueChanged="OnVolumeChanged"
                                        VerticalAlignment="Center"/>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- Список треков (со скроллом) -->
                    <Border Background="#1E1E1E" CornerRadius="6" VerticalAlignment="Top">
                        <!-- ★ Вот тут MaxHeight="340" — это ровно 10 песен ★ -->
                        <ScrollViewer VerticalScrollBarVisibility="Auto" MaxHeight="340">
                          <ListBox x:Name="MusicList"
                                   Background="Transparent"
                                   BorderThickness="0"
                                   SelectionChanged="OnMusicSelected">
                              <ListBox.Styles>
                                  <!-- ★ БАЗОВЫЙ СТИЛЬ ДЛЯ КАЖДОЙ ПЕСНИ ★ -->
                                  <Style Selector="ListBoxItem">
                                      <Setter Property="MinHeight" Value="32"/>
                                      <Setter Property="Padding" Value="10,0"/>
                                      <!-- Отступы: 4 слева/справа, 2 сверху/снизу -->
                                      <Setter Property="Margin" Value="4,2,4,2"/>
                                      <!-- Скругляем края -->
                                      <Setter Property="CornerRadius" Value="4"/>
                                      <Setter Property="VerticalContentAlignment" Value="Center"/>
                                  </Style>

                                  <!-- ★ ЭФФЕКТ ПРИ НАВЕДЕНИИ МЫШКОЙ ★ -->
                                  <Style Selector="ListBoxItem:pointerover /template/ ContentPresenter">
                                      <Setter Property="Background" Value="#2D2D30"/>
                                  </Style>

                                  <!-- ★ ЦВЕТ ВЫДЕЛЕННОЙ ПЕСНИ (вместо серого будет синий) ★ -->
                                  <Style Selector="ListBoxItem:selected /template/ ContentPresenter">
                                      <Setter Property="Background" Value="#007ACC"/>
                                      <Setter Property="CornerRadius" Value="4"/>
                                  </Style>

                                  <!-- ★ ТЕКСТ ВЫДЕЛЕННОЙ ПЕСНИ СТАНОВИТСЯ БЕЛЫМ ★ -->
                                  <Style Selector="ListBoxItem:selected TextBlock">
                                      <Setter Property="Foreground" Value="White"/>
                                  </Style>
                              </ListBox.Styles>
                              
                              <ListBox.ItemTemplate>
                                  <DataTemplate x:DataType="audio:MusicTrack">
                                      <TextBlock Text="{Binding DisplayName}"
                                                 Foreground="#CCCCCC"
                                                 FontSize="13"/>
                                  </DataTemplate>
                              </ListBox.ItemTemplate>
                          </ListBox>
                        </ScrollViewer>
                    </Border>

                </DockPanel>
            </Border>

            <GridSplitter Grid.Row="1" Background="#3E3E42" ResizeDirection="Rows" Height="4"/>

            <!-- ═══ КОЛОНКА 2, НИЗ — СВОЙСТВА ═══ -->
            <Border Grid.Row="2" Background="#252526" Padding="8">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top"
                               Text="СВОЙСТВА"
                               Foreground="White"
                               FontWeight="Bold"
                               Margin="0,0,0,8"/>
                    <ScrollViewer>
                        <StackPanel Spacing="8">
                            <TextBlock Text="Ничего не выбрано"
                                       Foreground="Gray"
                                       FontStyle="Italic"/>
                        </StackPanel>
                    </ScrollViewer>
                </DockPanel>
            </Border>

        </Grid>

        <!-- ★ ЗАСТАВКА ★ -->
        <Border x:Name="SplashOverlay" 
                Grid.ColumnSpan="3"
                Background="Black" 
                IsVisible="True"
                ZIndex="1000"
                Opacity="1"
                IsHitTestVisible="True">
            <Border.Transitions>
                <Transitions>
                    <DoubleTransition Property="Opacity" Duration="0:0:1.5"/>
                </Transitions>
            </Border.Transitions>
            <Image Source="/Assets/logo.png" 
                   Stretch="UniformToFill" 
                   RenderOptions.BitmapInterpolationMode="HighQuality"/>
        </Border>

    </Grid>
</Window>